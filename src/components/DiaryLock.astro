---
import { encryptDiary } from '../utils/diary-crypto';
const { enabled = true } = Astro.props;
const payload = enabled ? JSON.stringify(encryptDiary(await Astro.slots.render('default'))) : '';

---
{enabled ? (
  <section class="diary-lock" data-payload={payload}>
    <form class="lock-form">
      <p class="lock-label">PRIVATE DIARY</p>
      <h2>日记已上锁</h2>
      <p>输入密码，打开这些日常记录。</p>
      <label>访问密码<input type="password" name="password" required autocomplete="current-password" placeholder="请输入密码" /></label>
      <button type="submit">解锁日记 →</button>
      <p class="lock-error" role="status" aria-live="polite"></p>
      <noscript>请启用 JavaScript 后输入密码查看日记。</noscript>
    </form>
    <div class="lock-content" hidden></div>
  </section>
) : <slot />}

<script>
  document.querySelectorAll<HTMLElement>('.diary-lock').forEach((lock) => {
    const form = lock.querySelector<HTMLFormElement>('form')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const button = form.querySelector<HTMLButtonElement>('button')!;
    const error = form.querySelector<HTMLElement>('.lock-error')!;
    const content = lock.querySelector<HTMLElement>('.lock-content')!;
    const decode = (value: string) => Uint8Array.from(atob(value), (c) => c.charCodeAt(0));
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.textContent = '';
      if (!window.crypto?.subtle) {
        error.textContent = '请使用 HTTPS 或本地预览打开日记。';
        return;
      }
      button.disabled = true;
      button.textContent = '正在解锁…';
      try {
        const payload = JSON.parse(lock.dataset.payload!);
        const material = await crypto.subtle.importKey('raw', new TextEncoder().encode(input.value), 'PBKDF2', false, ['deriveKey']);
        const key = await crypto.subtle.deriveKey({ name: 'PBKDF2', salt: decode(payload.salt), iterations: 210000, hash: 'SHA-256' }, material, { name: 'AES-GCM', length: 256 }, false, ['decrypt']);
        const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: decode(payload.iv) }, key, decode(payload.data));
        content.innerHTML = new TextDecoder().decode(plain);
        content.hidden = false;
        form.hidden = true;
        input.value = '';
        delete lock.dataset.payload;
        document.dispatchEvent(new Event('diary:unlocked'));
        content.setAttribute('tabindex', '-1');
        content.focus();
      } catch {
        error.textContent = '密码不正确，请重新输入。';
        input.select();
      } finally {
        button.disabled = false;
        button.textContent = '解锁日记 →';
      }
    });
  });
</script>

<style>
  .lock-form { max-width: 440px; margin: 48px auto; padding: 36px 28px; border: 1px solid #e5e5df; background: #fbfbf8; }
  .lock-label { color: #8b8b83; font: 11px monospace; letter-spacing: .16em; }
  h2 { font-size: 28px; font-weight: 400; color: #171717; }
  p, label { color: #66665e; font-size: 14px; line-height: 1.8; }
  label { display: block; margin-top: 24px; }
  input { display: block; width: 100%; padding: 12px; margin: 8px 0 16px; border: 1px solid #ccc; background: white; font: inherit; }
  button { padding: 12px 22px; border: 0; background: #262620; color: white; font: inherit; cursor: pointer; }
  button:disabled { opacity: .6; cursor: wait; }
  .lock-error { min-height: 25px; color: #a13b32; }
  [hidden] { display: none !important; }
</style>
