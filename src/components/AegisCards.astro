---
import type { CollectionEntry } from 'astro:content';
interface Props { documents: CollectionEntry<'projects'>[] }
const { documents } = Astro.props;
---
<div class="cards">
  {documents.map((document,index)=><a class="card" href={`${import.meta.env.BASE_URL}/projects/aegis-agent/${document.id.split('/').at(-1)}/`}>
    <span class="number">{String(index+1).padStart(2,'0')}</span>
    <div>{document.data.subtitle && <p>{document.data.subtitle}</p>}<h3>{document.data.title}</h3><span class="description">{document.data.description}</span></div><span class="arrow">↗</span>
  </a>)}
</div>
<style>
.cards{border-top:1px solid #e4e4dd}.card{display:grid;grid-template-columns:40px 1fr 24px;gap:14px;padding:24px 8px;border-bottom:1px solid #e4e4dd;color:inherit;text-decoration:none}.card:hover{background:#f5f5f0}.number,.arrow{color:#999;font:12px monospace}.card p{margin:0 0 8px;color:#999;font-size:12px}.card h3{margin:0 0 8px;font-weight:400;font-size:23px}.description{color:#666;font-size:14px;line-height:1.75}@media(max-width:600px){.card{grid-template-columns:28px 1fr 16px;gap:8px}.card h3{font-size:20px}}
</style>
