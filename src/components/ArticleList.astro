---
import { readingTime } from "../utils/reading-time";

interface Props {
	posts: any[];
	showCategory?: boolean;
}

const { posts, showCategory = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<div class="article-list">
	{posts.length > 0 ? posts.map((post, index) => (
		<article class="article-row">
			<div class="article-index">{String(index + 1).padStart(2, "0")}</div>
			<div class="article-meta">
				<time datetime={post.data.date.toISOString()}>
					{post.data.date.toLocaleDateString("zh-CN")}
				</time>
				{showCategory && <span>{post.data.category}</span>}
				<span>约 {readingTime(post.body ?? "")} 分钟</span>
			</div>
			<div class="article-main">
				<h2>{post.data.title}</h2>
				<p>{post.data.description}</p>
				{(post.data.tags ?? []).length > 0 && (
					<div class="tags">
						{post.data.tags.map((tag: string) => <span>#{tag}</span>)}
					</div>
				)}
				<a href={`${base}posts/${post.id}/`}>阅读文章 <span>→</span></a>
			</div>
		</article>
	)) : (
		<p class="empty">这里还没有文章。</p>
	)}
</div>

<style>
	.article-list { border-top: 1px solid #ddd; }
	.article-row {
		display: grid;
		grid-template-columns: 36px 145px minmax(0, 1fr);
		gap: 20px;
		padding: 28px 0;
		border-bottom: 1px solid #e5e5df;
		transition: padding 0.2s ease, background 0.2s ease;
	}
	.article-row:hover { padding-left: 10px; background: rgba(245, 245, 239, 0.7); }
	.article-index { color: #aaa993; font-family: monospace; font-size: 11px; }
	.article-meta { display: flex; flex-direction: column; gap: 6px; color: #8b8b83; font-family: monospace; font-size: 11px; line-height: 1.5; }
	.article-main h2 { margin: 0 0 8px; color: #171717; font-family: Georgia, "Times New Roman", serif; font-size: 25px; font-weight: 400; }
	.article-main p { max-width: 600px; margin: 0; color: #4e4e4a; font-size: 13px; line-height: 1.75; }
	.tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
	.tags span { color: #8b8b83; font-family: monospace; font-size: 10px; }
	.article-main a { display: inline-flex; gap: 8px; margin-top: 14px; color: #333; font-size: 12px; text-decoration: none; }
	.article-main a span { transition: transform 0.2s ease; }
	.article-main a:hover span { transform: translateX(4px); }
	.empty { padding: 40px 0; color: #777; }
	@media (max-width: 600px) {
		.article-row { grid-template-columns: 28px 1fr; gap: 10px 14px; padding: 24px 0; }
		.article-meta { grid-column: 2; flex-direction: row; flex-wrap: wrap; gap: 4px 12px; }
		.article-main { grid-column: 2; }
		.article-index { grid-row: 1 / span 2; }
		.article-main h2 { font-size: 22px; }
	}
</style>
