---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "TSY · Mathematics & Thoughts",
	description = "TSY 的个人博客，记录数学、技术与生活。",
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	html {
		background: #fafafa;
	}

	body {
		margin: 0;
		color: #202020;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			sans-serif;
	}
</style>