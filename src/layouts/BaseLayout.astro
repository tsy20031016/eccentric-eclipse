---
import Header from "../components/Header.astro";
import MathManuscript from "../components/MathManuscript.astro";
import "../styles/paper.css";
import Footer from "../components/Footer.astro";
import "katex/dist/katex.min.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "TSY · Mathematics & Thoughts",
	description = "TSY 的个人博客，记录数学、技术与生活。",
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<div class="site-math-field"><MathManuscript quiet /></div>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	:root {
		--paper: #fbfaf6;
		--ink: #171717;
		--muted: #77776f;
		--rule: #e4e4dd;
		--math-ink: #8c8c78;
	}

	html {
		background: #fbfaf6;
	}

	body {
		margin: 0;
		background-color: var(--paper);
		color: #171717;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			sans-serif;
	}

	main,
	header,
	footer {
		position: relative;
		z-index: 1;
	}

	.site-math-field {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

</style>
