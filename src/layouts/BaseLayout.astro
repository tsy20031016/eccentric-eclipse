---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "TSY · Mathematics & Thoughts",
	description = "TSY 的个人博客，记录数学、技术与生活。",
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />

		<meta name="description" content={description} />

		<title>{title}</title>
	</head>

	<body>
		<div class="site-math-field" aria-hidden="true">
			<span class="math-note note-1">∑</span>
			<span class="math-note note-2">∂</span>
			<span class="math-note note-3">ε → 0</span>
			<span class="math-note note-4">ℝ</span>
			<span class="math-note note-5">∫ f(x) dx</span>
			<span class="math-note note-6">∀x ∈ A</span>
		</div>
		<Header />

		<main>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	:root {
		--paper: #fbfbf8;
		--ink: #171717;
		--muted: #77776f;
		--rule: #e4e4dd;
		--math-ink: #8c8c78;
	}

	html {
		background: #fafafa;
	}

	body {
		margin: 0;
		background: var(--paper);
		color: #171717;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			sans-serif;
	}

	main,
	header,
	footer {
		position: relative;
		z-index: 1;
	}

	.site-math-field {
		position: fixed;
		inset: 0;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
	}

	.math-note {
		position: absolute;
		color: #8c8c78;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(18px, 2.4vw, 32px);
		opacity: 0.075;
		user-select: none;
	}

	.note-1 { top: 18%; left: 7%; transform: rotate(-12deg); }
	.note-2 { top: 42%; right: 8%; transform: rotate(9deg); }
	.note-3 { top: 72%; left: 5%; transform: rotate(5deg); font-size: clamp(13px, 1.5vw, 20px); }
	.note-4 { top: 86%; right: 14%; transform: rotate(-8deg); }
	.note-5 { top: 31%; left: 88%; transform: rotate(-5deg); font-size: clamp(13px, 1.6vw, 22px); }
	.note-6 { top: 61%; right: 5%; transform: rotate(12deg); font-size: clamp(12px, 1.4vw, 19px); }
</style>