---
import { getEntry, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const project = await getEntry("projects", "aegis-agent");
const { Content } = await render(project);
---

<BaseLayout title="Aegis Agent · TSY" description={project.data.description}>
	<article class="project-paper">
		<a class="back" href={`${import.meta.env.BASE_URL}/projects/`}>← 全部项目</a>
		<p class="eyebrow">RESEARCH PROJECT · ENTERPRISE AGENT SYSTEM</p>
		<h1>{project.data.title}</h1>
		<p class="lead">{project.data.description}</p>
		<div class="paper-meta"><span>研究稿 · 持续更新</span><a href={`${import.meta.env.BASE_URL}/write/projects/aegis-agent/`}>打开项目编辑器 →</a></div>
		<hr />
		<div class="paper-body"><Content /></div>
	</article>
</BaseLayout>

<style>
	.project-paper{width:min(820px,calc(100% - 40px));margin:0 auto;padding:55px 0 110px;color:#222}
	.back{color:#777;text-decoration:none;font-size:13px}.eyebrow{margin:54px 0 16px;color:#888;font:11px monospace;letter-spacing:.16em}
	h1{margin:0;font:400 clamp(42px,8vw,68px)/1.1 Georgia,serif;letter-spacing:-.04em}.lead{max-width:650px;color:#666;font-size:18px;line-height:1.8}
	.paper-meta{display:flex;justify-content:space-between;gap:16px;margin:30px 0;color:#999;font-size:13px}.paper-meta a{color:#333;text-decoration:none}
	hr{border:0;border-top:1px solid #e4e4dd;margin:34px 0 46px}.paper-body{font-size:16px;line-height:1.95}.paper-body :global(h2){margin:44px 0 15px;font:400 28px Georgia,serif}.paper-body :global(h3){margin:30px 0 10px;font-size:19px}.paper-body :global(p){margin:0 0 20px}.paper-body :global(blockquote){margin:20px 0;padding:10px 18px;border-left:3px solid #ccc;color:#777}.paper-body :global(li){margin:8px 0}
	.paper-body :global(.katex-display){overflow-x:auto;overflow-y:hidden}.paper-body :global(table){width:100%;margin:22px 0;border-collapse:collapse;font-size:14px;line-height:1.65}.paper-body :global(th){background:#f2f2ee}.paper-body :global(th),.paper-body :global(td){border:1px solid #d8d8d1;padding:9px 11px;vertical-align:top}.paper-body :global(tbody tr:nth-child(even)){background:#fafaf7}.paper-body :global(img){max-width:100%;height:auto}
</style>
