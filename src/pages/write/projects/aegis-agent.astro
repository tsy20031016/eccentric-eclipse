---
import { aegisSections } from "../../../data/aegis-sections";
const apiUrl = "https://tsy-blog-api.1468709192.workers.dev/";
---
<!doctype html>
<html lang="zh-CN">
<head>
	<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
	<title>Aegis Agent 项目编辑器 · TSY</title>
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.css" />
	<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/contrib/auto-render.min.js"></script>
	<script defer src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
</head>
<body>
	<header><a href="/eccentric-eclipse/projects/aegis-agent/">← Aegis Agent</a><span>PROJECT EDITOR · 独立于文章写作</span><a href="/eccentric-eclipse/write/">普通文章写作 →</a></header>
	<main>
		<section class="intro"><p>RESEARCH WORKSPACE</p><h1>Aegis Agent</h1><div>企业级 Agent 执行系统 · 论文与技术文档工作区</div></section>
		<div class="bar"><button id="newChapter" type="button">＋ 新建章节</button><button id="deleteChapter" type="button" class="danger" disabled>删除当前章节</button><button data-insert="## 新章节\n\n在此撰写研究内容。">插入小节</button><button data-insert="\n$$\n\\begin{aligned}\na &= b+c\\\\\n  &= d\n\\end{aligned}\n$$\n">∑ 公式</button><button data-insert="\n| 指标 | 方法 | 结果 |\n| --- | --- | --- |\n| 待定义 | 待填写 | 待测量 |\n">▦ 表格模板</button><button data-insert="\n```mermaid\nflowchart LR\n  A[请求] --> B[策略校验]\n  B --> C[Agent 执行]\n  C --> D[审计记录]\n```\n">◇ 流程图</button><button data-insert="\n![图注：请填写说明](图片 URL)\n">▧ 图片</button><button data-insert="\n> **定义 1（名称）.** 在此填写正式定义。\n">定理块</button><label class="upload">上传图片<input id="asset" type="file" accept="image/*" hidden /></label><div class="style-tools" aria-label="字体格式"><label>颜色 <input id="fontColor" type="color" value="#222222" /></label><label>字号 <select id="fontSize"><option value="14">14</option><option value="16" selected>16</option><option value="18">18</option><option value="20">20</option><option value="24">24</option><option value="28">28</option><option value="32">32</option></select> px</label><button id="applyStyle" type="button">应用到选中文字</button></div><span id="status">本地草稿</span></div>
		<div class="meta"><label>正在编辑<select id="docSection"><option value="overview">项目说明</option><option value="abstract">摘要</option><option value="architecture">系统架构</option><option value="full">完整研究稿（旧稿）</option></select></label><label>文档标题<input id="docTitle" value="Aegis Agent — 企业级 Agent 执行系统" /></label><label>注释说明<input id="docSubtitle" placeholder="显示在文章卡片标题上方，可留空" /></label><label>文章简介<input id="docDescription" placeholder="显示在文章卡片标题下方" /></label><label>所属板块<select id="docGroup">{aegisSections.map(section => <option value={section.id}>{section.title}</option>)}</select></label><label>排序序号<input id="docOrder" type="number" min="0" step="1" value="100" /><small>同一板块内序号越小越靠前</small></label><label>版本说明<input id="revision" placeholder="例如：架构章节初稿" /></label><label>项目写入凭据（Worker Secret）<input id="projectToken" type="password" autocomplete="off" placeholder="输入 AEGIS_WRITE_TOKEN；仅保存在当前标签页" /></label></div>
		<div class="workspace"><section><div class="pane-title">Markdown 源稿 <span>支持 Markdown · LaTeX · Mermaid</span></div><textarea id="source" spellcheck="false" aria-label="项目论文 Markdown 源稿"></textarea></section><section><div class="pane-title">实时预览 <span>论文排版视图</span></div><article id="preview" class="preview"></article></section></div>
		<div class="actions"><button id="reload">从云端载入</button><button id="save">保存项目稿</button><span id="message" role="status"></span></div>
		<p class="notice">项目稿与普通文章完全独立。保存会提交到项目专用文件，并触发 GitHub Pages 构建。请勿在多人同时编辑时覆盖他人的新版本。</p>
	</main>
	<script define:vars={{ apiUrl, aegisSections }}>
		const source=document.querySelector('#source'),preview=document.querySelector('#preview'),message=document.querySelector('#message');
		const docSection=document.querySelector('#docSection');
		const draftKey=()=>`tsy-aegis-agent-project-draft-v2-${docSection.value}`;
		const projectEndpoint=()=>apiUrl+`projects/aegis-agent${docSection.value==='full'?'':'/'+docSection.value}`;
		const coreSections=new Set(['overview','abstract','architecture','full']);
		let activeSection=docSection.value;
		const authHeaders=()=>({'Content-Type':'application/json','X-Project-Write-Token':document.querySelector('#projectToken').value});
		function prepareProjectDocument(raw,title){
			const normalized=String(raw||'').replace(/^\uFEFF/,'').replace(/\r\n?/g,'\n');
			const match=normalized.match(/^---[ \t]*\n([\s\S]*?)\n---[ \t]*(?:\n|$)/);
			let metadata=match?match[1]:'';
			let body=match?normalized.slice(match[0].length):normalized.replace(/^---[ \t]*\n/,'');
			const order=Number(document.querySelector('#docOrder').value);
			if(!Number.isSafeInteger(order)||order<0)throw Error('排序序号必须为非负整数');
			const fields={title,description:document.querySelector('#docDescription').value,subtitle:document.querySelector('#docSubtitle').value,section:document.querySelector('#docGroup').value,order};
			for(const [name,value] of Object.entries(fields)){
				const line=new RegExp(`^${name}\\s*:[^\\n]*$`,'m');
				if(line.test(metadata))metadata=metadata.replace(line,`${name}: ${JSON.stringify(value)}`);
				else metadata+=(metadata?'\n':'')+`${name}: ${JSON.stringify(value)}`;
			}
			return `---\n${metadata}\n---\n\n${body.replace(/^\n+/, '')}`;
		}

		function syncMetadata(){
			const metadata=source.value.match(/^---[ \t]*\n([\s\S]*?)\n---[ \t]*(?:\n|$)/)?.[1]||'';
			const field=(name,fallback)=>{const value=metadata.match(new RegExp('^'+name+':\\s*(.*)$','m'))?.[1]?.trim();if(value===undefined)return fallback;try{return JSON.parse(value);}catch{return value.replace(/^'|'$/g,'');}};
			document.querySelector('#docTitle').value=field('title',docSection.selectedOptions[0]?.text||'Aegis Agent');
			document.querySelector('#docDescription').value=field('description','');
			document.querySelector('#docSubtitle').value=field('subtitle','');
			document.querySelector('#docOrder').value=field('order',100);
			document.querySelector('#docGroup').value=field('section','foundation');
		}
		const escapeHtml=(s)=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
		const inline=(value)=>String(value).split(/(<span style="color:#[\da-f]{6};font-size:\d+px">[\s\S]*?<\/span>)/gi).map(part=>{const styled=part.match(/^<span style="color:(#[\da-f]{6});font-size:(\d+)px">([\s\S]*)<\/span>$/i);if(styled)return `<span style="color:${styled[1]};font-size:${styled[2]}px">${inline(styled[3])}</span>`;return escapeHtml(part).replace(/`([^`]+)`/g,'<code>$1</code>').replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/(?<!\*)\*([^*]+)\*(?!\*)/g,'<em>$1</em>');}).join('');
		const parsePipeRow=(line)=>line.trim().replace(/^\|/,'').replace(/\|$/,'').split(/(?<!\\)\|/).map(cell=>cell.trim().replace(/\\\|/g,'|'));
		const isSeparator=(cells)=>cells.length>0&&cells.every(cell=>/^:?-{3,}:?$/.test(cell.replace(/\s/g,'')));
		const normalizeTable=(input)=>{let rows=input.replace(/\r/g,'').split('\n').filter(line=>line.includes('|')).map(parsePipeRow);rows=rows.filter(row=>!isSeparator(row));if(rows.length<2||rows.every(row=>row.length<2))return null;const compact=rows[0].join('').replace(/\s/g,'');if(rows[0].length>=3&&rows[0].slice(1).every(cell=>!cell)&&compact.includes('维度名称数学对象取值/判据'))rows[0]=['维度编号','维度名称','数学对象','取值/判据'];const width=Math.max(...rows.map(row=>row.length));if(rows[0].length<width)rows[0]=[...rows[0],...Array(width-rows[0].length).fill('列标题')];rows=rows.map(row=>[...row,...Array(Math.max(0,width-row.length)).fill('')]);return [rows[0],Array(width).fill('---'),...rows.slice(1)].map(row=>`| ${row.join(' | ')} |`).join('\n');};
		const render=()=>{const blocks=source.value.replace(/^---[ \t]*\n[\s\S]*?\n---[ \t]*(?:\n|$)/,'').trim().split(/\n\s*\n/); preview.innerHTML=blocks.map(b=>{const t=b.trim(); if(t.startsWith('```mermaid'))return `<pre class="mermaid">${escapeHtml(t.replace(/^```mermaid\s*/, '').replace(/```$/, ''))}</pre>`; if(t.startsWith('```'))return `<pre><code>${escapeHtml(t.replace(/^```\w*\n?/, '').replace(/```$/, ''))}</code></pre>`; if(/^#{1,3}\s/.test(t)){const n=(t.match(/^#+/)[0].length),text=t.replace(/^#+\s/, '');return `<h${n}>${inline(text)}</h${n}>`;} if(t.startsWith('>'))return `<blockquote>${t.replace(/^>\s?/gm,'').split('\n').map(inline).join('<br>')}</blockquote>`; if(/^\|.*\|$/.test(t.split('\n')[0])){const rows=t.split('\n').filter(x=>x.trim()).map(parsePipeRow).filter(row=>!isSeparator(row));const width=Math.max(...rows.map(row=>row.length));return `<div class="table-scroll"><table><thead><tr>${rows[0].map(c=>`<th>${inline(c)}</th>`).join('')}</tr></thead><tbody>${rows.slice(1).map(r=>`<tr>${Array.from({length:width},(_,i)=>`<td>${inline(r[i]||'')}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;} if(/^[-*]\s/m.test(t))return `<ul>${t.split('\n').map(x=>`<li>${inline(x.replace(/^[-*]\s/,''))}</li>`).join('')}</ul>`; const image=t.match(/^!\[([^\]]*)\]\(([^)]+)\)$/); if(image)return `<figure><img src="${escapeHtml(image[2])}" alt="${escapeHtml(image[1])}"><figcaption>${inline(image[1])}</figcaption></figure>`; return `<p>${t.split('\n').map(inline).join('<br>')}</p>`;}).join(''); if(window.renderMathInElement)renderMathInElement(preview,{delimiters:[{left:'$$',right:'$$',display:true},{left:'$',right:'$',display:false},{left:'\\(',right:'\\)',display:false},{left:'\\[',right:'\\]',display:true}],throwOnError:false}); if(window.mermaid){mermaid.initialize({startOnLoad:false,securityLevel:'strict',theme:'neutral'});mermaid.run({nodes:preview.querySelectorAll('.mermaid')}).catch(()=>{});}};
		const isAdmin=localStorage.getItem('tsy-blog-admin-token');
		if(!isAdmin){source.readOnly=true;document.querySelectorAll('.bar button,.upload,#save,#reload,.meta input,.meta select').forEach(x=>x.disabled=true);message.textContent='请先登录写作后台，再打开项目编辑器。';const link=document.createElement('a');link.href='/eccentric-eclipse/write/';link.textContent='前往写作后台登录';link.style.cssText='display:inline-block;margin-left:10px;color:#222';message.after(link);}
		for(const id of ['docTitle','docDescription','docSubtitle','docGroup','docOrder'])document.getElementById(id).addEventListener('change',()=>{if(!isAdmin)return;try{source.value=prepareProjectDocument(source.value,document.querySelector('#docTitle').value);source.dispatchEvent(new Event('input'));}catch(error){message.textContent=error.message;}});
		let timer;source.addEventListener('input',()=>{render();clearTimeout(timer);const key=draftKey();const draft=source.value;timer=setTimeout(()=>{if(isAdmin)localStorage.setItem(key,draft);document.querySelector('#status').textContent='草稿已自动保存';},300);});
		document.querySelectorAll('[data-insert]').forEach(b=>b.onclick=()=>{const a=source.selectionStart,z=source.selectionEnd;source.setRangeText(b.dataset.insert,a,z,'end');source.dispatchEvent(new Event('input'));source.focus();});
		document.querySelector('#applyStyle').onclick=()=>{const start=source.selectionStart,end=source.selectionEnd;const selected=source.value.slice(start,end)||'选中文字';const color=document.querySelector('#fontColor').value;const size=document.querySelector('#fontSize').value;source.setRangeText(`<span style="color:${color};font-size:${size}px">${selected}</span>`,start,end,'end');source.dispatchEvent(new Event('input'));source.focus();};
		source.addEventListener('paste',(event)=>{const clipboard=event.clipboardData;if(!clipboard)return;let table=null;const html=clipboard.getData('text/html');if(html&&/<table[\s>]/i.test(html)){const doc=new DOMParser().parseFromString(html,'text/html');const rows=[...doc.querySelectorAll('tr')].map(tr=>[...tr.querySelectorAll('th,td')].map(cell=>cell.innerText.trim()));if(rows.length>1){const width=Math.max(...rows.map(row=>row.length));table=[rows[0],Array(width).fill('---'),...rows.slice(1)].map(row=>`| ${[...row,...Array(width-row.length).fill('')].join(' | ')} |`).join('\n');}}if(!table){const text=clipboard.getData('text/plain');table=normalizeTable(text);if(!table){const tsv=text.replace(/\r/g,'').split('\n').filter(line=>line.trim()).map(line=>line.split('\t').map(cell=>cell.trim()));if(tsv.length>1&&tsv.some(row=>row.length>1)){const width=Math.max(...tsv.map(row=>row.length));table=[tsv[0],Array(width).fill('---'),...tsv.slice(1)].map(row=>`| ${[...row,...Array(width-row.length).fill('')].join(' | ')} |`).join('\n');}}}if(!table)return;event.preventDefault();const start=source.selectionStart,end=source.selectionEnd;source.setRangeText(`\n${table}\n`,start,end,'end');source.dispatchEvent(new Event('input'));});
		async function load(){const selected=docSection.value;message.textContent='正在载入…';try{const r=await fetch(projectEndpoint());const j=await r.json();if(selected!==docSection.value)return;if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);source.value=j.content;syncMetadata();localStorage.setItem(draftKey(),j.content);message.textContent='已载入服务器版本';source.dispatchEvent(new Event('input'));}catch(e){if(selected!==docSection.value)return;const saved=localStorage.getItem(draftKey());if(saved){source.value=saved;syncMetadata();}message.textContent=saved?'云端读取失败，已恢复本地草稿：'+e.message:'载入失败：'+e.message;source.dispatchEvent(new Event('input'));}}
		function syncDeleteButton(){document.querySelector('#deleteChapter').disabled=!isAdmin||coreSections.has(docSection.value);}
		async function refreshDocuments(){try{const r=await fetch(apiUrl+'projects/aegis-agent/documents');const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);const keep=docSection.value;for(const option of [...docSection.options])if(option.value!=='full')option.remove();for(const item of j.documents||[]){const option=document.createElement('option');option.value=item.slug;option.textContent=item.title;docSection.append(option);}if([...docSection.options].some(option=>option.value===keep))docSection.value=keep;else docSection.value='overview';syncDeleteButton();}catch(error){message.textContent='章节列表读取失败：'+error.message;}}
		docSection.addEventListener('change',()=>{localStorage.setItem(`tsy-aegis-agent-project-draft-v2-${activeSection}`,source.value);activeSection=docSection.value;const saved=localStorage.getItem(draftKey());source.value=saved||'';syncMetadata();source.dispatchEvent(new Event('input'));syncDeleteButton();load();});
		document.querySelector('#newChapter').onclick=async()=>{if(!isAdmin)return;const title=prompt('请输入新章节标题：');if(!title?.trim())return;const token=document.querySelector('#projectToken').value;if(!token){message.textContent='请先输入 Cloudflare Worker 的 AEGIS_WRITE_TOKEN';return;}const button=document.querySelector('#newChapter');button.disabled=true;message.textContent='正在创建章节…';try{const r=await fetch(apiUrl+'projects/aegis-agent/documents',{method:'POST',headers:authHeaders(),body:JSON.stringify({title:title.trim()})});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);await refreshDocuments();docSection.value=j.slug;activeSection=j.slug;document.querySelector('#docTitle').value=j.title;source.value='';source.dispatchEvent(new Event('input'));syncDeleteButton();await load();message.textContent='章节已创建并载入；保存内容后网站会重新构建。';}catch(error){message.textContent='创建章节失败：'+error.message;}finally{button.disabled=false;}}
		document.querySelector('#deleteChapter').onclick=async()=>{if(!isAdmin||coreSections.has(docSection.value))return;const slug=docSection.value,title=docSection.selectedOptions[0].text;if(!confirm(`确定永久删除章节“${title}”吗？此操作会从项目仓库删除该文档。`))return;const token=document.querySelector('#projectToken').value;if(!token){message.textContent='请先输入 Cloudflare Worker 的 AEGIS_WRITE_TOKEN';return;}const button=document.querySelector('#deleteChapter');button.disabled=true;message.textContent='正在删除章节…';try{const r=await fetch(apiUrl+`projects/aegis-agent/documents/${slug}`,{method:'DELETE',headers:{'X-Project-Write-Token':token}});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);localStorage.removeItem(`tsy-aegis-agent-project-draft-v2-${slug}`);for(const option of [...docSection.options])if(option.value===slug)option.remove();docSection.value='overview';activeSection='overview';document.querySelector('#docTitle').value=docSection.selectedOptions[0].text;source.value='';syncDeleteButton();await load();message.textContent='章节已删除，网站正在重新构建。';}catch(error){message.textContent='删除章节失败：'+error.message;syncDeleteButton();}}
		document.querySelector('#reload').onclick=()=>{if(!isAdmin)return;if(source.value.trim()&&!confirm('重新载入会替换当前编辑区。继续？'))return;load();};
		document.querySelector('#save').onclick=async()=>{
			if(!isAdmin)return;
			const button=document.querySelector('#save');button.disabled=true;message.textContent='正在保存…';
			try{
				const projectToken=document.querySelector('#projectToken').value;
				if(!projectToken)throw Error('请先输入 Cloudflare Worker 的 AEGIS_WRITE_TOKEN');
				const title=String(document.querySelector('#docTitle').value||'Aegis Agent').trim();
				const content=prepareProjectDocument(source.value,title);
				const r=await fetch(projectEndpoint(),{method:'POST',headers:{'Content-Type':'application/json','X-Project-Write-Token':projectToken},body:JSON.stringify({content,title,revision:document.querySelector('#revision').value})});
				const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);
				source.value=content;localStorage.setItem(draftKey(),content);source.dispatchEvent(new Event('input'));message.textContent='✓ 当前项目文档已保存，GitHub Pages 正在构建';
			}catch(e){message.textContent='保存失败：'+e.message;}finally{button.disabled=false;}
		};
		document.querySelector('#asset').onchange=async(e)=>{if(!isAdmin){e.target.value='';return;}const file=e.target.files?.[0];if(!file)return;message.textContent='图片上传中…';try{const projectToken=document.querySelector('#projectToken').value;if(!projectToken)throw Error('请先输入 Worker 的 AEGIS_WRITE_TOKEN');const r=await fetch(apiUrl+'projects/upload',{method:'POST',headers:{'Content-Type':file.type,'X-Project-Write-Token':projectToken},body:file});const j=await r.json();if(!r.ok||!j.success)throw Error(j.message||`HTTP ${r.status}`);const a=source.selectionStart;source.setRangeText(`\n![${file.name}](${j.url})\n`,a,source.selectionEnd,'end');source.dispatchEvent(new Event('input'));message.textContent='图片已上传并插入';}catch(err){message.textContent='图片上传失败：'+err.message;}e.target.value='';};
		const localDraft=localStorage.getItem(draftKey());if(localDraft){source.value=localDraft;syncMetadata();message.textContent=isAdmin?'已恢复本地项目草稿；如需服务器稿请点“从云端载入”':'当前为只读预览，请先登录后台。';source.dispatchEvent(new Event('input'));}else if(isAdmin)load();
		refreshDocuments();syncDeleteButton();
	</script>
</body>
<style>
	:root{font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;color:#24241f;background:#f6f6f2}*{box-sizing:border-box}body{margin:0}header{height:58px;padding:0 max(24px,calc((100vw - 1320px)/2));display:flex;align-items:center;justify-content:space-between;background:#fff;border-bottom:1px solid #e5e5df;font-size:13px}header a{color:#333;text-decoration:none}header span{color:#999;font:10px monospace;letter-spacing:.12em}main{max-width:1320px;margin:auto;padding:48px 24px 80px}.intro>p{font:11px monospace;letter-spacing:.18em;color:#888}.intro h1{font:400 clamp(36px,5vw,54px) Georgia,serif;margin:14px 0}.intro div{color:#777}.bar,.actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:26px 0 16px}.bar button,.upload,.actions button{border:1px solid #ddd;background:#fff;border-radius:6px;padding:9px 12px;font-size:13px;cursor:pointer}.bar button:hover,.actions button:hover{border-color:#888}.bar button.danger{color:#a33;border-color:#e7dada}.bar button:disabled{opacity:.48;cursor:not-allowed}.upload{display:inline-block}.bar #status{margin-left:auto;color:#888;font-size:12px}.meta{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:20px 0}.meta label{font-size:12px;color:#777}.meta input,.meta select{display:block;width:100%;margin-top:7px;padding:10px;border:1px solid #ddd;border-radius:5px;background:#fff}.workspace{display:grid;grid-template-columns:1fr 1fr;gap:14px}.workspace>section{min-width:0;background:white;border:1px solid #dfdfd9;border-radius:8px;overflow:hidden}.pane-title{padding:12px 15px;border-bottom:1px solid #e9e9e4;font-size:13px;font-weight:600}.pane-title span{float:right;color:#999;font-weight:400;font-size:11px}textarea{display:block;width:100%;height:70vh;min-height:580px;resize:vertical;border:0;padding:22px;font:14px/1.85 ui-monospace,Consolas,monospace;outline:none}.preview{height:70vh;min-height:580px;overflow:auto;padding:24px 30px;font:15px/1.9 Georgia,"Songti SC",serif}.preview h1,.preview h2,.preview h3{font-weight:500;line-height:1.35}.preview h2{margin-top:2em}.preview p{margin:0 0 1.1em;white-space:pre-wrap}.preview blockquote{border-left:3px solid #ccc;margin:1em 0;padding:8px 16px;color:#666}.preview pre{overflow:auto;padding:14px;background:#f5f5f2;border-radius:5px}.preview table{width:100%;border-collapse:collapse}.preview th,.preview td{border:1px solid #ddd;padding:8px;text-align:left}.preview figure{margin:24px 0;text-align:center}.preview img{max-width:100%;max-height:500px}.preview figcaption{color:#888;font-size:12px}.preview :global(.katex-display){overflow-x:auto;overflow-y:hidden}.actions #save{background:#222;color:#fff;border-color:#222;padding:10px 18px}.actions span{font-size:13px;color:#666}.notice{color:#999;font-size:12px;line-height:1.7;margin-top:18px}@media(max-width:780px){header{padding:0 14px}header span{display:none}main{padding:30px 14px}.workspace,.meta{grid-template-columns:1fr}.workspace textarea,.preview{height:55vh;min-height:420px}.bar #status{width:100%;margin:4px 0}}
	.style-tools{display:flex;align-items:center;gap:7px;padding:4px 8px;border:1px solid #e2e2dc;border-radius:6px;background:#fff}.style-tools label{display:flex;align-items:center;gap:5px;color:#666;font-size:12px}.style-tools input[type=color]{width:30px;height:26px;padding:1px;border:0;background:transparent;cursor:pointer}.style-tools select{height:28px;border:1px solid #ddd;border-radius:4px;background:#fff}.style-tools button{padding:7px 9px}.preview :global(.table-scroll){max-width:100%;overflow-x:auto;margin:18px 0 26px}.preview :global(table){width:100%;min-width:620px;border-collapse:collapse;font-family:inherit;font-size:14px;line-height:1.65}.preview :global(th){background:#f2f2ee;font-weight:600}.preview :global(th),.preview :global(td){border:1px solid #d8d8d1;padding:9px 11px;vertical-align:top}.preview :global(tbody tr:nth-child(even)){background:#fafaf7}.preview :global(td .katex){font-size:1em}.preview :global(strong){font-weight:700}.preview :global(code){padding:1px 4px;background:#f3f3ef;border-radius:3px}
</style>
</html>
