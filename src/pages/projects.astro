---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
	{
		number: "01",
		title: "Personal Blog",
		description:
			"一个用 Astro 构建的个人博客，用来记录数学、技术与生活。",
		tags: ["Astro", "Markdown", "GitHub"],
	},
	{
		number: "02",
		title: "AI Girlfriend",
		description:
			"一个属于自己的 AI 对话系统，探索 AI、记忆与长期陪伴。",
		tags: ["Python", "FastAPI", "AI"],
	},
	{
		number: "03",
		title: "More to come",
		description:
			"这里留给未来。也许是数学相关的项目，也许是某个突然冒出来的想法。",
		tags: ["Future"],
	},
];
---

<BaseLayout title="项目 · TSY">
	<header class="page-header">
		<p class="eyebrow">PROJECTS</p>

		<h1>我做过的东西。</h1>

		<p class="intro">
			一些正在做、已经做过，
			或者只是觉得有意思而动手尝试的东西。
		</p>
	</header>

	<main class="projects-container">
		<div class="project-list">
			{projects.map((project) => (
				<article class="project">
					<div class="project-number">
						{project.number}
					</div>

					<div class="project-main">
						<h2>{project.title}</h2>

						<p>{project.description}</p>

						<div class="tags">
							{project.tags.map((tag) => (
								<span>{tag}</span>
							))}
						</div>
					</div>

					<div class="project-arrow">
						→
					</div>
				</article>
			))}
		</div>
	</main>
</BaseLayout>

<style>
	.page-header {
		max-width: 900px;
		margin: 0 auto;
		padding: 100px 24px 90px;
		border-bottom: 1px solid #e5e5e5;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 12px;
		letter-spacing: 0.18em;
		color: #888;
	}

	.page-header h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(44px, 7vw, 70px);
		font-weight: 400;
		line-height: 1.15;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 560px;
		margin: 28px 0 0;
		color: #777;
		font-size: 17px;
		line-height: 1.9;
	}

	.projects-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 24px 120px;
	}

	.project {
		display: grid;
		grid-template-columns: 70px 1fr 40px;
		gap: 30px;
		align-items: start;
		padding: 42px 0;
		border-bottom: 1px solid #e5e5e5;
		transition: padding-left 0.2s ease;
	}

	.project:hover {
		padding-left: 8px;
	}

	.project-number {
		font-family: monospace;
		font-size: 12px;
		color: #aaa;
	}

	.project-main h2 {
		margin: 0 0 12px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 28px;
		font-weight: 500;
	}

	.project-main p {
		max-width: 580px;
		margin: 0;
		color: #777;
		line-height: 1.8;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 20px;
	}

	.tags span {
		padding: 5px 9px;
		border: 1px solid #ddd;
		color: #888;
		font-family: monospace;
		font-size: 11px;
	}

	.project-arrow {
		font-size: 20px;
		color: #aaa;
		transition: transform 0.2s ease;
	}

	.project:hover .project-arrow {
		transform: translateX(5px);
	}

	@media (max-width: 600px) {
		.page-header {
			padding: 70px 20px 60px;
		}

		.projects-container {
			padding: 0 20px 80px;
		}

		.project {
			grid-template-columns: 40px 1fr;
			gap: 16px;
			padding: 32px 0;
		}

		.project-arrow {
			display: none;
		}

		.project-main h2 {
			font-size: 24px;
		}
	}
</style>