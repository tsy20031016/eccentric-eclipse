			});


			// ========================================
			// Markdown 预览
			// ========================================

			function escapeHtml(text) {
				return text
					.replaceAll(
						"&",
						"&amp;"
					)
					.replaceAll(
						"<",
						"&lt;"
					)
					.replaceAll(
						">",
						"&gt;"
					);
			}


			function renderInlineMarkdown(content) {
				let html = escapeHtml(content);

				html = html.replace(
					/&lt;span style=&quot;color:\s*(#[0-9a-f]{6})&quot;&gt;(.*?)&lt;\/span&gt;/gis,
					'<span style="color: $1">$2</span>'
				);

				html = html.replace(
					/!\[(.*?)\]\((.*?)\)/g,
					'<img src="$2" alt="$1" loading="lazy" />'
				);

				html = html.replace(
					/\[(.*?)\]\((.*?)\)/g,
					'<a href="$2" target="_blank" rel="noopener">$1</a>'
				);

				html = html.replace(
					/\*\*(.*?)\*\*/g,
					"<strong>$1</strong>"
				);

				html = html.replace(
					/(?<!\*)\*(?!\*)(.*?)\*(?!\*)/g,
					"<em>$1</em>"
				);

				return html;
			}

			function markdownToHtml(markdown) {
				const source = String(markdown ?? "").replace(/\r\n/g, "\n").trim();

				if (!source) {
					return "";
				}

				const blocks = [];
				let currentBlock = [];
				let inDisplayMath = false;

				for (const line of source.split("\n")) {
					if (line.trim() === "$$") {
						inDisplayMath = !inDisplayMath;
						currentBlock.push(line);

						if (!inDisplayMath) {
							blocks.push(currentBlock.join("\n"));
							currentBlock = [];
						}

						continue;
					}

					if (inDisplayMath) {
						currentBlock.push(line);
						continue;
					}

					if (!line.trim()) {
						if (currentBlock.length) {
							blocks.push(currentBlock.join("\n"));
							currentBlock = [];
						}

						continue;
					}

					currentBlock.push(line);
				}

				if (currentBlock.length) {
					blocks.push(currentBlock.join("\n"));
				}

				return blocks
					.map((block) => {
						const value = block.trim();

						if (!value) {
							return "";
						}

						if (/^\$\$[\s\S]*\$\$$/.test(value)) {
							return `<div class="math-preview">${renderInlineMarkdown(value)}</div>`;
						}

						if (/^###\s+/.test(value)) {
							return `<h3>${renderInlineMarkdown(value.replace(/^###\s+/, ""))}</h3>`;
						}

						if (/^##\s+/.test(value)) {
							return `<h2>${renderInlineMarkdown(value.replace(/^##\s+/, ""))}</h2>`;
						}

						if (/^#\s+/.test(value)) {
							return `<h1>${renderInlineMarkdown(value.replace(/^#\s+/, ""))}</h1>`;
						}

						if (/^>\s+/.test(value)) {
							const quote = value
								.replace(/^>\s?/gm, "")
								.trim();

							return `<blockquote>${renderInlineMarkdown(quote)}</blockquote>`;
						}

						if (/^(?:[-*]\s+.*)(?:\n(?:[-*]\s+.*))+$/.test(value)) {
							const items = value
								.split(/\n/)
								.map((line) => line.trim())
								.filter(Boolean)
								.map((line) => line.replace(/^[-*]\s+/, ""));

							return `<ul>${items
									.map((item) => `<li>${renderInlineMarkdown(item)}</li>`)
									.join("")}</ul>`;
						}

						const paragraphs = value
							.split(/\n+/)
							.map((line) => line.trim())
							.filter(Boolean);

						return paragraphs
							.map((paragraph) => `<p>${renderInlineMarkdown(paragraph)}</p>`)
							.join("");
					})
					.join("");
			}


			function renderPreviewMath() {
				if (!window.renderMathInElement) {
					return;
				}

				const delimiters = [
					{
						left: "$$",
						right: "$$",
						display: true,
					},
					{
						left: "$",
						right: "$",
						display: false,
					},
					{
						left: "\\(",
						right: "\\)",
						display: false,
					},
					{
						left: "\\[",
						right: "\\]",
						display: true,
					},
				];

				const options = {
					delimiters,
					throwOnError: false,
				};

				window.renderMathInElement(preview, options);
				window.renderMathInElement(fullPreview, options);
			}


			function renderPreview() {
				const html =
					markdownToHtml(
						normalizeParagraphMarkdown(getContent())
					);

				preview.innerHTML = html;

				fullPreview.innerHTML =
					html;

				renderPreviewMath();
			}

			window.addEventListener("load", renderPreviewMath, { once: true });


			function showPreview() {
				renderPreview();

				// 编辑区保持显示，预览放在正文下方
				content.hidden = false;

				// 保留编辑器内部的备用预览，但不占用布局
				preview.hidden = true;

				// 显示下面的大预览
				previewSection.hidden = false;

				editTab.classList.remove(
					"active"
				);

				previewTab.classList.add(
					"active"
				);

				// 滚动到下面的预览
				setTimeout(() => {
					previewSection.scrollIntoView({
						behavior: "smooth",
						block: "start",
					});
				}, 50);
			}


			function showEditor() {
				content.hidden = false;

				preview.hidden = true;

				previewSection.hidden = true;

				previewTab.classList.remove(
					"active"
				);

				editTab.classList.add(
					"active"
				);
			}


			editTab.addEventListener(
				"click",
				showEditor
			);

			previewTab.addEventListener(
				"click",
				showPreview
			);


			// ========================================
			// 图片上传
			// ========================================

			async function uploadImage(file) {
				if (!file) {
					return;
				}

				if (
					!file.type.startsWith(
						"image/"
					)
				) {
					uploadStatus.textContent =
						"请选择图片文件。";

					return;
				}

				if (
					file.size >
					10 * 1024 * 1024
				) {
					uploadStatus.textContent =
						"图片不能超过 10MB。";

					return;
				}

				uploadStatus.textContent =
					`正在上传 ${file.name}…`;

				try {
					const response =
						await fetch(
							apiUrl + "upload",
							{
								method: "POST",

								headers: {
									"Content-Type":
										file.type,
								},

								body: file,
							}
						);

					const result =
						await response.json();

					if (
						!response.ok ||
						!result.success
					) {
						throw new Error(
							result.message ||
							"图片上传失败"
						);
					}

					const imageMarkdown =
						`\n\n![${file.name}](${result.url})\n\n`;

					insertAtCursor(
						imageMarkdown
					);

					uploadStatus.textContent =
						"✓ 图片上传成功，已插入正文。";

					saveDraft();

				} catch (error) {
					console.error(error);

					uploadStatus.textContent =
						"图片上传失败：" +
						error.message;
				}
			}


			function insertAtCursor(text) {
				content.focus();

				const selection = window.getSelection();
				if (!selection || selection.rangeCount === 0) {
					content.appendChild(document.createTextNode(text));
					scheduleSave();
					return;
				}

				const range = selection.getRangeAt(0);
				if (!content.contains(range.commonAncestorContainer)) {
					content.appendChild(document.createTextNode(text));
					scheduleSave();
					return;
				}

				range.deleteContents();
				const node = document.createTextNode(text);
				range.insertNode(node);
				range.setStartAfter(node);
				range.collapse(true);
			selection.removeAllRanges();
			selection.addRange(range);

				scheduleSave();
			}


			imageInput.addEventListener(
				"change",
				async () => {
					const file =
						imageInput.files?.[0];

					await uploadImage(file);

					imageInput.value = "";
				}
			);


			// ========================================
			// 拖入图片
			// ========================================

			if (dropZone) {
				dropZone.addEventListener(
					"dragover",
					(event) => {
						event.preventDefault();
						dropZone.classList.add("is-over");
					}
				);

				dropZone.addEventListener(
					"dragleave",
					(event) => {
						if (
							!dropZone.contains(
								event.relatedTarget
							)
						) {
							dropZone.classList.remove("is-over");
						}
					}
				);

				dropZone.addEventListener(
					"drop",
					async (event) => {
						event.preventDefault();
						dropZone.classList.remove("is-over");

						const files =
							Array.from(
								event.dataTransfer.files
							);

						const images =
							files.filter(
								(file) =>
									file.type.startsWith(
										"image/"
									)
							);

						for (
							const file of images
						) {
							await uploadImage(
								file
							);
						}
					}
				);
			}


			// ========================================
			// 清空草稿
			// ========================================

			clearDraft.addEventListener(
				"click",
				() => {
					const wasEditing =
						Boolean(editingFilename);

					const confirmed =
						confirm(
							wasEditing
								? "退出编辑并清空表单吗？（不会改动已发布的文章）"
								: "确定要清空当前草稿吗？"
						);

					if (!confirmed) {
						return;
					}

					exitEditMode();

					title.value = "";

					description.value =
						"";

					category.value =
						"随笔";

					date.value =
						new Date()
							.toISOString()
							.slice(0, 10);

					tags.value = "";

					setContent("");

					if (!wasEditing) {
						localStorage.removeItem(
							DRAFT_KEY
						);
					}

					saveStatus.textContent =
						wasEditing
							? "● 已退出编辑"
							: "● 草稿已清空";

					message.textContent =
						"";

					uploadStatus.textContent =
						"";

					showEditor();
				}
			);


			// ========================================
			// 发布 / 更新文章
			// ========================================

			// 统一的 JSON POST 请求，带友好的错误提示
			async function postJson(url, body) {
				let response;

				try {
					response = await fetch(url, {
						method: "POST",

						headers: {
							"Content-Type":
								"application/json",
						},

						body: JSON.stringify(body),
					});
				} catch (error) {
					throw new Error(
						"网络请求失败，请检查网络后重试"
					);
				}

				const rawText = await response.text();

				let result;

				try {
					result = JSON.parse(rawText);
				} catch (error) {
					if (
						rawText === "Not Found" ||
						response.status === 404
					) {
						throw new Error(
							"线上 Worker 仍是旧版（不支持编辑/删除）。请把仓库 worker/index.js 整份部署到 tsy-blog-api，部署后访问 /version 应返回 version: 3"
						);
					}

					throw new Error(
						"API 返回格式异常，请确认已部署仓库 worker/ 目录里的新版 Worker"
					);
				}

				if (
					result &&
					result.message ===
						"TSY Blog API is running."
				) {
					// 旧版 Worker 对未知路径返回这个提示
					throw new Error(
						"API 还不支持该操作，请先部署仓库 worker/ 目录里的新版 Worker"
					);
				}

				if (!response.ok || !result.success) {
					throw new Error(
						result.message ||
							`请求失败（HTTP ${response.status}）`
					);
				}

				return result;
			}


			button.addEventListener(
				"click",
				async () => {
					if (
						!title.value.trim()
					) {
						message.textContent =
							"请先填写标题。";

						title.focus();

						return;
					}

					if (
						!getContent().trim()
					) {
						message.textContent =
							"正文还没有写呢。";

						content.focus();

						return;
					}

					const isEditing =
						Boolean(editingFilename);

					button.disabled = true;

					button.innerHTML =
						isEditing
							? "<span>正在更新……</span>"
							: "<span>正在发布……</span>";

					message.textContent =
						"";

					try {
						const tagList =
							tags.value
								.split(",")
								.map(
									(tag) =>
										tag.trim()
								)
								.filter(Boolean);

						const payload = {
							title:
								title.value,

							description:
								description.value,

							category:
								category.value,

							date:
								date.value,

							tags:
								tagList,

							content:
								normalizeParagraphMarkdown(getContent()),
						};

						if (isEditing) {
							payload.filename =
								editingFilename;
						}

						await postJson(
							isEditing
								? apiUrl + "posts/update"
								: apiUrl,
							payload
						);

						if (isEditing) {
							message.textContent =
								"✓ 文章已更新！GitHub 正在自动部署。";

							exitEditMode();
						} else {
							message.textContent =
								"✓ 发布成功！GitHub 正在自动部署。";

							localStorage.removeItem(
								DRAFT_KEY
							);

							saveStatus.textContent =
								"● 草稿已清除";
						}

						title.value = "";

						description.value =
							"";

						category.value =
							"随笔";

						tags.value = "";

						setContent("");

						date.value =
							new Date()
								.toISOString()
								.slice(0, 10);

						showEditor();

					} catch (error) {
						console.error(error);

						message.textContent =
							(isEditing
								? "更新失败："
								: "发布失败：") +
							error.message;

					} finally {
						button.disabled =
							false;

						updatePublishButton();
					}
				}
			);


			// ========================================
			// 文章管理：编辑 / 删除
			// ========================================

			const editorSection = document.querySelector(".editor");

			function setAdminAccess(isAllowed) {
				if (isAllowed) {
					adminAuth.hidden = true;
					editorSection.hidden = false;
					logoutAdmin.hidden = false;
					return;
				}

				adminAuth.hidden = false;
				editorSection.hidden = true;
				logoutAdmin.hidden = true;
				adminPassword.focus();
			}

			function unlockAdmin() {
				const entered =
					String(adminPassword.value ?? "");

				if (entered !== ADMIN_PASSWORD) {
					adminAuthMessage.textContent = "密码不正确。";
					adminPassword.focus();
					return;
				}

				localStorage.setItem(
					"tsy-blog-admin-token",
					ADMIN_PASSWORD
				);

				adminAuthMessage.textContent = "";
				adminPassword.value = "";
				setAdminAccess(true);
			}

			function lockAdmin() {
				localStorage.removeItem("tsy-blog-admin-token");
				adminAuthMessage.textContent = "";
				adminPassword.value = "";
				setAdminAccess(false);
			}

			if (!localStorage.getItem("tsy-blog-admin-token")) {
				setAdminAccess(false);
			} else {
				setAdminAccess(true);
			}

			adminLogin.addEventListener("click", unlockAdmin);
			logoutAdmin.addEventListener("click", lockAdmin);

			adminPassword.addEventListener("keydown", (event) => {
				if (event.key === "Enter") {
					unlockAdmin();
				}
			});

			manageList.addEventListener(
				"click",
				async (event) => {
					const editButton =
						event.target.closest(
							".manage-edit"
						);

					if (editButton) {
						enterEditMode(
							editButton.dataset.filename
						);

						return;
					}

					const deleteButton =
						event.target.closest(
							".manage-delete"
						);

					if (!deleteButton) {
						return;
					}

					const filename =
						deleteButton.dataset.filename;

					const post = postsIndex.find(
						(item) =>
							item.filename === filename
					);

					const confirmed = confirm(
						`确定要删除《${
							post ? post.title : filename
						}》吗？删除后无法恢复。`
					);

					if (!confirmed) {
						return;
					}

					deleteButton.disabled = true;

					deleteButton.textContent =
						"删除中…";

					try {
						await postJson(
							apiUrl + "posts/delete",
							{ filename }
						);

						const row =
							manageList.querySelector(
								`.manage-row[data-filename="${CSS.escape(filename)}"]`
							);

						if (row) {
							row.remove();
						}

						if (editingFilename === filename) {
							exitEditMode();
						}

						const remaining =
							manageList.querySelectorAll(
								".manage-row"
							).length;

						manageCount.textContent =
							`${remaining} 篇`;

						message.textContent =
							"✓ 已删除，GitHub 正在自动部署。";

					} catch (error) {
						console.error(error);

						message.textContent =
							"删除失败：" +
							error.message;

						deleteButton.disabled = false;

						deleteButton.textContent =
							"删除";
					}
				}
			);
		</script>
	</body>
</html>


