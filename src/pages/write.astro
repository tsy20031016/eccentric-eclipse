---
import { getCollection } from "astro:content";

const apiUrl = "https://tsy-blog-api.1468709192.workers.dev/";

// 文章管理列表（构建时生成，每次部署后自动更新）
const postsIndex = (await getCollection("posts"))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.map((post) => ({
		filename: `${post.id}.md`,
		title: post.data.title,
		category: post.data.category,
		date: post.data.date.toLocaleDateString("zh-CN"),
		url: `/eccentric-eclipse/posts/${post.id}/`,
	}));

// 构建时内联所有文章原文，编辑模式用它回填表单
const rawFiles = import.meta.glob("../content/posts/*.md", {
	query: "?raw",
	import: "default",
	eager: true,
});

	const rawContents: Record<string, string> = {};

for (const [path, raw] of Object.entries(rawFiles)) {
	const filename = path.split("/").pop();

	if (filename) {
		rawContents[filename] = raw;
	}
}
