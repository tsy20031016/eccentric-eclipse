			// ========================================
			// 草稿系统
			// ========================================

			const DRAFT_KEY =
				"tsy-blog-draft-v4";

			let saveTimer = null;


			function normalizeParagraphMarkdown(text) {
				const lines = String(text ?? "")
					.replace(/\r\n/g, "\n")
					.split("\n");

				const blocks = [];
				let index = 0;

				while (index < lines.length) {
					const line = lines[index];
					const trimmed = line.replace(/\u00a0/g, " ").trim();

					if (trimmed.startsWith("```") || trimmed === "$$" || trimmed === "\\[") {
						if (trimmed.startsWith("```")) {
							const codeLines = [line];
							index += 1;

							while (index < lines.length) {
								codeLines.push(lines[index]);
								if (lines[index].trim() === "```") {
									index += 1;
									break;
								}
								index += 1;
							}

							blocks.push(codeLines.join("\n"));
							continue;
						}

						const closingDelimiter = trimmed === "$$" ? "$$" : "\\]";
						const formulaLines = [trimmed];
						index += 1;

						while (index < lines.length) {
							const formulaLine = lines[index];
							formulaLines.push(formulaLine);
							index += 1;

							if (formulaLine.trim() === closingDelimiter) {
								break;
							}
						}

						blocks.push(formulaLines.join("\n"));
						continue;
					}

					if (!trimmed) {
						index += 1;
						continue;
					}

					if (/^(?:#{1,6}\s|[-*]\s|\d+\.\s|>\s)/.test(trimmed)) {
						if (/^(?:[-*]|\d+\.)\s/.test(trimmed)) {
							const marker = /^\d+\./.test(trimmed) ? /^\d+\.\s/ : /^[-*]\s/;
							const listLines = [trimmed];
							index += 1;

							while (index < lines.length && marker.test(lines[index].trim())) {
								listLines.push(lines[index].trim());
								index += 1;
							}

							blocks.push(listLines.join("\n"));
							continue;
						}

						blocks.push(trimmed);
						index += 1;
						continue;
					}

					if (/^(?:---|\*\*\*|___)$/.test(trimmed)) {
						blocks.push(trimmed);
						index += 1;
						continue;
					}

					// 每按一次回车，都当作一个新段落
					blocks.push(trimmed);
					index += 1;
				}

				return blocks
					.filter(Boolean)
					.map((block) => block.trim())
					.join("\n\n");
			}

			function colorToHex(color) {
				if (/^#[0-9a-f]{6}$/i.test(color)) {
					return color;
				}

				const match = color.match(/^rgb\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)$/i);
				if (!match) {
					return null;
				}

				return `#${match.slice(1).map((value) => Number(value).toString(16).padStart(2, "0")).join("")}`;
			}


			function serializeEditorNode(node) {
				if (node.nodeType === Node.TEXT_NODE) {
					return node.textContent || "";
				}

				if (node.nodeType !== Node.ELEMENT_NODE) {
					return "";
				}

				const element = node;
				const inner = [...element.childNodes]
					.map(serializeEditorNode)
					.join("");

				if (element.tagName === "BR") {
					return "\n";
				}

				if (element.tagName === "STRONG" || element.tagName === "B") {
					return `**${inner}**`;
				}

				if (element.tagName === "EM" || element.tagName === "I") {
					return `*${inner}*`;
				}

				if (element.tagName === "SPAN" && element.style.color) {
					const color = colorToHex(element.style.color);
					if (color) {
						return `<span style="color: ${color}">${inner}</span>`;
					}
				}

				if (element.tagName === "FONT" && element.color) {
					const color = colorToHex(element.color);
					if (color) {
						return `<span style="color: ${color}">${inner}</span>`;
					}
				}

				if (element.tagName === "FONT" && element.size) {
					const sizes = { "2": "14px", "3": "16px", "4": "20px", "5": "24px" };
					const size = sizes[element.size];
					if (size) {
						return `<span style="font-size: ${size}">${inner}</span>`;
					}
				}

				if (["DIV", "P"].includes(element.tagName)) {
					return `${inner}\n\n`;
				}

				return inner;
			}

			function getContent() {
				return [...content.childNodes]
					.map(serializeEditorNode)
					.join("")
					.replace(/\u00a0/g, " ")
					.trim();
			}


			function setContent(value) {
				let html = escapeHtml(value || "");
				html = html
					.replace(/&lt;strong&gt;(.*?)&lt;\/strong&gt;/gis, "<strong>$1</strong>")
					.replace(/\*\*(.*?)\*\*/gs, "<strong>$1</strong>")
					.replace(/&lt;span style="color:\s*(#[0-9a-f]{6})"&gt;(.*?)&lt;\/span&gt;/gis, '<span style="color: $1">$2</span>')
					.replace(/&lt;span style="font-size:\s*(\d+px)"&gt;(.*?)&lt;\/span&gt;/gis, '<span style="font-size: $1">$2</span>')
					.replace(/\n/g, "<br>");
				content.innerHTML = html;
			}


			function getDraft() {
				return {
					title: title.value,
					description: description.value,
					category: category.value,
					date: date.value,
					tags: tags.value,
					content: getContent(),
				};
			}


			function saveDraft() {
				// 编辑已有文章时不写草稿，避免覆盖"新建文章"的草稿
				if (editingFilename) {
					return;
