			const manageCount =
				document.querySelector("#manageCount");

			const boldButton =
				document.querySelector("#boldButton");

			const textColor =
				document.querySelector("#textColor");


			// ========================================
			// 编辑模式状态
			// ========================================

			// 为 null 时是"新建文章"模式；
			// 为文件名（如 test-1787935999476.md）时是"编辑已有文章"模式。
			let editingFilename = null;


			// ========================================
			// 日期默认值
			// ========================================

			if (!date.value) {
				date.value =
					new Date()
						.toISOString()
						.slice(0, 10);
			}


			// ========================================
			// 草稿系统
			// ========================================

			const DRAFT_KEY =
				"tsy-blog-draft-v4";

			let saveTimer = null;


			function normalizeParagraphMarkdown(text) {
				const lines = String(text ?? "")
					.replace(/\r\n/g, "\n")
					.split("\n");

				const blocks = [];
				let currentParagraph = [];

				for (const line of lines) {
					const trimmed = line.replace(/\u00a0/g, " ").trim();

					if (!trimmed) {
						if (currentParagraph.length) {
							blocks.push(currentParagraph.join(" "));
							currentParagraph = [];
						}
						continue;
					}

					if (/^(?:#{1,6}\s|[-*]\s|\d+\.\s|>\s)/.test(trimmed)) {
						if (currentParagraph.length) {
							blocks.push(currentParagraph.join(" "));
							currentParagraph = [];
						}
						blocks.push(trimmed);
						continue;
					}

					// 每按一次回车，都当作一个新段落
					blocks.push(trimmed);
				}

				if (currentParagraph.length) {
					blocks.push(currentParagraph.join(" "));
				}

				return blocks
					.filter(Boolean)
					.map((block) => block.trim())
					.join("\n\n");
			}

			function serializeEditorNode(node) {
				if (node.nodeType === Node.TEXT_NODE) {
					return node.textContent || "";
				}

				if (node.nodeType !== Node.ELEMENT_NODE) {
					return "";
				}

				const element = node;
				const inner = [...element.childNodes]
					.map(serializeEditorNode)
					.join("");

				if (element.tagName === "BR") {
					return "\n";
				}

				if (element.tagName === "STRONG" || element.tagName === "B") {
					return `**${inner}**`;
				}

				if (element.tagName === "EM" || element.tagName === "I") {
					return `*${inner}*`;
				}

				if (element.tagName === "SPAN" && element.style.color) {
					const color = element.style.color;
					if (/^#[0-9a-f]{6}$/i.test(color)) {
						return `<span style="color: ${color}">${inner}</span>`;
					}
				}

				if (element.tagName === "FONT" && element.color) {
					const color = element.color;
					if (/^#[0-9a-f]{6}$/i.test(color)) {
						return `<span style="color: ${color}">${inner}</span>`;
					}
				}

				if (["DIV", "P"].includes(element.tagName)) {
					return `${inner}\n\n`;
				}

				return inner;
			}

			function getContent() {
				return [...content.childNodes]
					.map(serializeEditorNode)
					.join("")
					.replace(/\u00a0/g, " ")
					.trim();
			}


			function setContent(value) {
				let html = escapeHtml(value || "");
				html = html
					.replace(/&lt;strong&gt;(.*?)&lt;\/strong&gt;/gis, "<strong>$1</strong>")
					.replace(/\*\*(.*?)\*\*/gs, "<strong>$1</strong>")
					.replace(/&lt;span style=&quot;color:\s*(#[0-9a-f]{6})&quot;&gt;(.*?)&lt;\/span&gt;/gis, '<span style="color: $1">$2</span>')
					.replace(/\n/g, "<br>");
				content.innerHTML = html;
			}


			function getDraft() {
				return {
					title: title.value,
					description: description.value,
					category: category.value,
					date: date.value,
					tags: tags.value,
					content: getContent(),
				};
			}


			function saveDraft() {
				// 编辑已有文章时不写草稿，避免覆盖"新建文章"的草稿
				if (editingFilename) {
					return;
				}

				const draft = getDraft();

				localStorage.setItem(
					DRAFT_KEY,
					JSON.stringify(draft)
				);

				saveStatus.textContent =
					"● 草稿已保存";
			}


			function loadDraft() {
				const raw =
					localStorage.getItem(
						DRAFT_KEY
					);

				if (!raw) {
					return;
				}

				try {
					const draft =
						JSON.parse(raw);

					title.value =
						draft.title || "";

					description.value =
						draft.description || "";

					category.value =
						draft.category || "随笔";

					date.value =
						draft.date ||
						new Date()
							.toISOString()
							.slice(0, 10);

					tags.value =
						draft.tags || "";

					setContent(draft.content || "");

					saveStatus.textContent =
						"● 已恢复草稿";

				} catch (error) {
					console.error(
						"读取草稿失败",
						error
					);
				}
			}


			function scheduleSave() {
				if (editingFilename) {
					return;
				}

				saveStatus.textContent =
					"● 正在保存…";

				clearTimeout(saveTimer);

				saveTimer =
					setTimeout(
						saveDraft,
						500
					);
			}


			[
				title,
				description,
				category,
				date,
				tags,
				content,
			].forEach((element) => {
				element.addEventListener(
					"input",
					scheduleSave
				);

				element.addEventListener(
					"change",
					scheduleSave
				);
			});


			loadDraft();


			// ========================================
			// 编辑 / 删除已有文章
			// ========================================

			// 解析 Markdown 原文里的 frontmatter（简单场景够用）
			function parseRawPost(raw) {
				const match = raw.match(
					/^---\r?\n([\s\S]*?)\r?\n---\r?\n?/
				);

				if (!match) {
					return { fields: {}, body: raw };
				}

				const yaml = match[1];

				const body = raw.slice(match[0].length);

				const fields = {};

				const lines = yaml.split(/\r?\n/);

				for (let i = 0; i < lines.length; i++) {
					const lineMatch =
						lines[i].match(/^([\w-]+):\s*(.*)$/);

					if (!lineMatch) {
						continue;
					}

					const key = lineMatch[1];

					let value = lineMatch[2].trim();

					if (value === "") {
						// 可能是块列表：tags:\n  - "a"\n  - "b"
						const items = [];

						let j = i + 1;

						while (
							j < lines.length &&
							/^\s+-\s?/.test(lines[j])
						) {
							items.push(
								lines[j]
									.replace(/^\s+-\s?/, "")
									.trim()
									.replace(/^["']|["']$/g, "")
							);

							j++;
						}

						if (items.length) {
							fields[key] = items;

							i = j - 1;
						} else {
							fields[key] = "";
						}

						continue;
					}

					if (
						(value.startsWith('"') && value.endsWith('"')) ||
						(value.startsWith("'") && value.endsWith("'"))
					) {
						value = value.slice(1, -1);
					}

					// 行内数组：tags: ["a", "b"]
					if (
						value.startsWith("[") &&
						value.endsWith("]")
					) {
						value = value
							.slice(1, -1)
							.split(",")
							.map((item) =>
								item
									.trim()
									.replace(/^["']|["']$/g, "")
							)
							.filter(Boolean);
					}

					fields[key] = value;
				}

				return { fields, body };
			}


			function normalizeDate(value) {
				const text = String(value || "");

				if (/^\d{4}-\d{2}-\d{2}/.test(text)) {
					return text.slice(0, 10);
				}

				const parsed = new Date(text);

				if (!Number.isNaN(parsed.valueOf())) {
					return parsed.toISOString().slice(0, 10);
				}

				return new Date()
					.toISOString()
					.slice(0, 10);
			}


			function updatePublishButton() {
				button.innerHTML = editingFilename
					? '<span>更新文章</span><span class="publish-arrow">↻</span>'
					: '<span>发布文章</span><span class="publish-arrow">→</span>';
			}


			function enterEditMode(filename) {
				const raw = rawContents[filename];

				if (!raw) {
					message.textContent =
						"找不到这篇文章的内容，可能是刚发布还没重新部署，稍后再试。";

					return;
				}

				const post = postsIndex.find(
					(item) => item.filename === filename
				);

				const { fields, body } =
					parseRawPost(raw);

				editingFilename = filename;

				title.value = fields.title || "";

				description.value =
					fields.description || "";

				category.value =
					fields.category || "随笔";

				date.value = normalizeDate(fields.date);

				tags.value = Array.isArray(fields.tags)
					? fields.tags.join(", ")
					: fields.tags || "";

				setContent(body);

				editBanner.hidden = false;

				editBannerTitle.textContent =
					(fields.title || filename);

				message.textContent = "";

				updatePublishButton();

				saveStatus.textContent =
					"● 编辑模式";

				window.scrollTo({
					top: 0,
					behavior: "smooth",
				});
			}


			function exitEditMode() {
				editingFilename = null;

				editBanner.hidden = true;

				updatePublishButton();

				saveStatus.textContent =
					"● 草稿未保存";
