			// ========================================
			// Markdown 预览
			// ========================================

			function escapeHtml(text) {
				return text
					.replaceAll(
						"&",
						"&amp;"
					)
					.replaceAll(
						"<",
						"&lt;"
					)
					.replaceAll(
						">",
						"&gt;"
					);
			}

			function renderKatexHtml(rawExpression, displayMode = false) {
				const expression = String(rawExpression ?? "").trim();

				if (!expression) {
					return "";
				}

				if (!window.katex) {
					return escapeHtml(expression);
				}

				try {
					return window.katex.renderToString(expression, {
						displayMode,
						throwOnError: false,
						strict: "warn",
						trust: false,
					});
				} catch (error) {
					return `<span class="math-error">${escapeHtml(expression)}</span>`;
				}
			}


			function renderInlineMarkdown(content) {
				let html = escapeHtml(content);

				html = html.replace(
					/&lt;span style="color:\s*(#[0-9a-f]{6})"&gt;(.*?)&lt;\/span&gt;/gis,
					'<span style="color: $1">$2</span>'
				);

				html = html.replace(
					/&lt;span style="font-size:\s*(\d+px)"&gt;(.*?)&lt;\/span&gt;/gis,
					'<span style="font-size: $1">$2</span>'
				);

				html = html.replace(
					/!\[(.*?)\]\((.*?)\)/g,
					'<img src="$2" alt="$1" loading="lazy" />'
				);

				html = html.replace(
					/\[(.*?)\]\((.*?)\)/g,
					'<a href="$2" target="_blank" rel="noopener">$1</a>'
				);

				html = html.replace(
					/\*\*(.*?)\*\*/g,
					"<strong>$1</strong>"
				);

				html = html.replace(
					/`([^`]+)`/g,
					"<code>$1</code>"
				);

				html = html.replace(
					/(?<!\*)\*(?!\*)(.*?)\*(?!\*)/g,
					"<em>$1</em>"
				);

				return html;
			}

			function markdownToHtml(markdown) {
				const source = String(markdown ?? "").replace(/\r\n/g, "\n").trim();

				if (!source) {
					return "";
				}

				const blocks = [];
				let currentBlock = [];
				let displayClosingDelimiter = null;

				for (const line of source.split("\n")) {
					const trimmedLine = line.trim();

					if (trimmedLine === "$$" || trimmedLine === "\\[") {
						displayClosingDelimiter = trimmedLine === "$$" ? "$$" : "\\]";
						currentBlock.push(line);
						continue;
					}

					if (displayClosingDelimiter) {
						currentBlock.push(line);

						if (trimmedLine === displayClosingDelimiter) {
							blocks.push(currentBlock.join("\n"));
							currentBlock = [];
							displayClosingDelimiter = null;
						}

						continue;
					}

					if (!line.trim()) {
						if (currentBlock.length) {
							blocks.push(currentBlock.join("\n"));
							currentBlock = [];
						}

						continue;
					}

					currentBlock.push(line);
				}

				if (currentBlock.length) {
					blocks.push(currentBlock.join("\n"));
				}

				return blocks
					.map((block) => {
						const value = block.trim();

						if (!value) {
							return "";
						}

						if (/^```[\w-]*\n[\s\S]*```$/.test(value)) {
							const code = value
								.replace(/^```[\w-]*\n?/, "")
								.replace(/\n?```$/, "");

							return `<pre><code>${escapeHtml(code)}</code></pre>`;
						}

						const displayMathMatch = value.match(/^\$\$([\s\S]*?)\$\$$/);
						if (displayMathMatch) {
							return `<div class="math-preview">${renderKatexHtml(displayMathMatch[1], true)}</div>`;
						}

						const bracketDisplayMatch = value.match(/^\\\[([\s\S]*?)\\\]$/);
						if (bracketDisplayMatch) {
							return `<div class="math-preview">${renderKatexHtml(bracketDisplayMatch[1], true)}</div>`;
						}

						const inlineMathMatch = value.match(/^\$([^$\n][\s\S]*?)\$$/);
						if (inlineMathMatch) {
							return `<span class="math-inline">${renderKatexHtml(inlineMathMatch[1], false)}</span>`;
						}

						const escapedInlineMathMatch = value.match(/^\\\((.*? )\\\)$/);
						if (escapedInlineMathMatch) {
							return `<span class="math-inline">${renderKatexHtml(escapedInlineMathMatch[1], false)}</span>`;
						}

						if (/^###\s+/.test(value)) {
							return `<h3>${renderInlineMarkdown(value.replace(/^###\s+/, ""))}</h3>`;
						}

						if (/^##\s+/.test(value)) {
							return `<h2>${renderInlineMarkdown(value.replace(/^##\s+/, ""))}</h2>`;
						}

						if (/^#\s+/.test(value)) {
							return `<h1>${renderInlineMarkdown(value.replace(/^#\s+/, ""))}</h1>`;
						}

						if (/^>\s+/.test(value)) {
							const quote = value
								.replace(/^>\s?/gm, "")
								.trim();

							return `<blockquote>${renderInlineMarkdown(quote)}</blockquote>`;
						}

						if (/^(?:\d+\.\s+.*)(?:\n\d+\.\s+.*)*$/.test(value)) {
							const items = value
								.split(/\n/)
								.map((line) => line.replace(/^\d+\.\s+/, ""));

							return `<ol>${items.map((item) => `<li>${renderInlineMarkdown(item)}</li>`).join("")}</ol>`;
						}

						if (/^(?:---|\*\*\*|___)$/.test(value)) {
							return "<hr />";
						}

						if (/^(?:[-*]\s+.*)(?:\n(?:[-*]\s+.*))*$/.test(value)) {
							const items = value
								.split(/\n/)
								.map((line) => line.trim())
								.filter(Boolean)
								.map((line) => line.replace(/^[-*]\s+/, ""));

							return `<ul>${items
									.map((item) => `<li>${renderInlineMarkdown(item)}</li>`)
									.join("")}</ul>`;
						}

						const paragraphs = value
							.split(/\n+/)
							.map((line) => line.trim())
							.filter(Boolean);

						return paragraphs
							.map((paragraph) => `<p>${renderInlineMarkdown(paragraph)}</p>`)
							.join("");
					})
					.join("");
			}


