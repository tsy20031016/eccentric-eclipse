			function loadDraft() {
				const raw =
					localStorage.getItem(
						DRAFT_KEY
					);

				if (!raw) {
					return;
				}

				try {
					const draft =
						JSON.parse(raw);

					title.value =
						draft.title || "";

					description.value =
						draft.description || "";

					category.value =
						draft.category || "随笔";

					date.value =
						draft.date ||
						new Date()
							.toISOString()
							.slice(0, 10);

					tags.value =
						draft.tags || "";

					setContent(draft.content || "");

					saveStatus.textContent =
						"● 已恢复草稿";

				} catch (error) {
					console.error(
						"读取草稿失败",
