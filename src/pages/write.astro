---
const apiUrl = "https://tsy-blog-api.1468709192.workers.dev/";
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="TSY Blog 写作后台" />
		<title>Write · TSY</title>
	</head>

	<body>
		<main>
			<header>
				<a href="/">TSY</a>
				<span>WRITE</span>
			</header>

			<section class="editor">
				<p class="eyebrow">A PLACE TO KEEP IDEAS</p>

				<h1>写点什么。</h1>

				<div class="form">
					<label>
						<span>标题</span>
						<input
							id="title"
							type="text"
							placeholder="文章标题"
						/>
					</label>

					<label>
						<span>描述</span>
						<input
							id="description"
							type="text"
							placeholder="简单描述一下这篇文章"
						/>
					</label>

					<label>
						<span>分类</span>
						<select id="category">
							<option value="随笔">随笔</option>
							<option value="数学">数学</option>
							<option value="AI">AI</option>
							<option value="技术">技术</option>
							<option value="生活">生活</option>
						</select>
					</label>

					<label>
						<span>正文</span>
						<textarea
							id="content"
							placeholder="在这里写下你的想法……

支持 Markdown，例如：

# 标题

这是正文。

$$
f(x)=x^2
$$"
						></textarea>
					</label>

					<button id="publish">发布文章</button>

					<p id="message"></p>
				</div>
			</section>
		</main>

		<script define:vars={{ apiUrl }}>
			const title = document.querySelector("#title");
			const description = document.querySelector("#description");
			const category = document.querySelector("#category");
			const content = document.querySelector("#content");
			const button = document.querySelector("#publish");
			const message = document.querySelector("#message");

			button.addEventListener("click", async () => {
				if (!title.value.trim()) {
					message.textContent = "请先填写标题。";
					return;
				}

				if (!content.value.trim()) {
					message.textContent = "正文还没有写呢。";
					return;
				}

				button.disabled = true;
				button.textContent = "正在发布……";
				message.textContent = "";

				try {
					const response = await fetch(apiUrl, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							title: title.value,
							description: description.value,
							category: category.value,
							content: content.value,
						}),
					});

					const result = await response.json();

					if (!response.ok || !result.success) {
						throw new Error(
							result.message || "发布失败"
						);
					}

					message.textContent =
						"✓ 发布成功！GitHub 正在自动部署。";

					title.value = "";
					description.value = "";
					content.value = "";

				} catch (error) {
					console.error(error);

					message.textContent =
						"发布失败：" + error.message;
				} finally {
					button.disabled = false;
					button.textContent = "发布文章";
				}
			});
		</script>
	</body>
</html>

<style>
	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: #fafafa;
		color: #202020;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			sans-serif;
	}

	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 28px 24px 100px;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 80px;
	}

	header a {
		color: #202020;
		font-size: 20px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-decoration: none;
	}

	header span {
		color: #999;
		font-size: 12px;
		letter-spacing: 0.18em;
	}

	.editor {
		max-width: 680px;
	}

	.eyebrow {
		margin: 0 0 20px;
		color: #999;
		font-size: 11px;
		letter-spacing: 0.16em;
	}

	h1 {
		margin: 0 0 50px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(44px, 9vw, 72px);
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.form {
		display: flex;
		flex-direction: column;
		gap: 28px;
	}

	label {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	label span {
		color: #777;
		font-size: 13px;
	}

	input,
	select,
	textarea {
		width: 100%;
		border: 1px solid #ddd;
		border-radius: 4px;
		background: white;
		padding: 14px 16px;
		color: #222;
		font: inherit;
		outline: none;
	}

	input:focus,
	select:focus,
	textarea:focus {
		border-color: #999;
	}

	textarea {
		min-height: 360px;
		resize: vertical;
		line-height: 1.8;
	}

	button {
		border: 0;
		border-radius: 4px;
		background: #202020;
		color: white;
		padding: 15px 20px;
		font: inherit;
		cursor: pointer;
	}

	button:hover {
		opacity: 0.85;
	}

	button:disabled {
		cursor: wait;
		opacity: 0.5;
	}

	#message {
		margin: 0;
		min-height: 24px;
		color: #777;
		font-size: 14px;
	}

	@media (max-width: 600px) {
		main {
			padding: 22px 20px 70px;
		}

		header {
			padding-bottom: 60px;
		}

		textarea {
			min-height: 300px;
		}
	}
</style>