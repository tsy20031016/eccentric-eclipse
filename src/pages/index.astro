---
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import ArticleList from "../components/ArticleList.astro";

const allPosts = (await getCollection("posts"))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const posts = allPosts.slice(0, 4);

const mathPosts = allPosts.filter((post) => post.data.category === "数学").slice(0, 2);
const aiPosts = allPosts.filter((post) => post.data.category === "AI").slice(0, 2);
const diaryPosts = allPosts.filter((post) => post.data.category === "日记").slice(0, 2);

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const homeUrl = base;
const postsUrl = `${base}posts/`;
const projectsUrl = `${base}projects/`;
const aboutUrl = `${base}about/`;
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta
			name="description"
			content="TSY 的个人空间，记录数学、AI、技术与生活。"
		/>
		<meta name="theme-color" content="#fafafa" />

		<title>TSY · Mathematics & Thoughts</title>
	</head>

	<body>
		<Header />

		<main>
			<!-- ========================================
			     Hero
			========================================= -->

			<section class="hero">
				<div class="math-scatter" aria-hidden="true">
					<span class="scatter-1">∑</span>
					<span class="scatter-2">lim x → 0</span>
					<span class="scatter-3">ℝ</span>
					<span class="scatter-4">∂</span>
				</div>
				<div class="hero-inner">
					<p class="eyebrow">
						MATHEMATICS · THOUGHTS · LIFE
					</p>

					<h1>
						记录思考，
						<br />
						也记录生活。
					</h1>

					<p class="hero-description">
						这里是 TSY 的个人空间。
						<br />
						记录数学学习、技术折腾，
						以及那些值得留下来的想法。
					</p>

					<div class="hero-actions">
						<a class="primary-button" href={postsUrl}>
							开始阅读
							<span>→</span>
						</a>

						<a class="text-button" href={aboutUrl}>
							了解我
						</a>
					</div>
				</div>

				<div class="hero-mark">
					<span>∫</span>
				</div>
			</section>

			<section class="thinking-section">
				<div class="section-label">
					<span>NOW</span>
					<span>CURRENTLY THINKING ABOUT</span>
				</div>
				<div class="thinking-list">
					<span>Mathematical Analysis</span>
					<span>AI</span>
					<span>LaTeX</span>
					<span>Programming</span>
				</div>
			</section>

			<section class="category-notes-section">
				<div class="section-label"><span>02</span><span>RECENT NOTES</span></div>
				<div class="category-note-grid">
					<section class="category-note"><h2>数学</h2><ArticleList posts={mathPosts} showCategory={false} /></section>
					<section class="category-note"><h2>AI</h2><ArticleList posts={aiPosts} showCategory={false} /></section>
					<section class="category-note"><h2>日记</h2><ArticleList posts={diaryPosts} showCategory={false} /></section>
				</div>
			</section>


			<!-- ========================================
			     About
			========================================= -->

			<section class="about-section">
				<div class="section-label">
					<span>01</span>
					<span>ABOUT ME</span>
				</div>

				<div class="about-grid">
					<div>
						<h2>
							一个正在学习<br />
							如何理解世界的人。
						</h2>
					</div>

					<div class="about-text">
						<p>
							我正在学习数学，也在尝试理解一些
							看起来很难的问题。
						</p>

						<p>
							有时候是数学，有时候是技术，
							有时候只是生活里突然冒出来的一个念头。
						</p>

						<a class="arrow-link" href={aboutUrl}>
							关于我
							<span>↗</span>
						</a>
					</div>
				</div>
			</section>


			<!-- ========================================
			     Posts
			========================================= -->

			<section class="posts-section">
				<div class="section-heading">
					<div>
						<div class="section-label">
										<span>03</span>
							<span>LATEST POSTS</span>
						</div>

						<h2>最近写了些什么</h2>
					</div>

					<a class="view-all" href={postsUrl}>
						查看全部
						<span>→</span>
					</a>
				</div>

				<div class="post-list">
					{
						posts.map((post) => (
							<a
								class="post-item"
								href={`${postsUrl}${post.id}/`}
							>
								<div class="post-meta">
									<time datetime={post.data.date.toISOString()}>
										{post.data.date.toLocaleDateString(
											"zh-CN",
											{
												year: "numeric",
												month: "2-digit",
												day: "2-digit",
											}
										)}
									</time>

									<span>{post.data.category}</span>
								</div>

								<div class="post-content">
									<h3>{post.data.title}</h3>

									<p>
										{post.data.description}
									</p>
								</div>

								<div class="post-arrow">
									↗
								</div>
							</a>
						))
					}
				</div>
			</section>


			<!-- ========================================
			     Projects
			========================================= -->

			<section class="projects-section">
				<div class="section-label">
					<span>04</span>
					<span>PROJECTS</span>
				</div>

				<div class="projects-heading">
					<h2>
						正在做的，
						<br />
						以及曾经折腾过的。
					</h2>

					<a class="arrow-link" href={projectsUrl}>
						查看项目
						<span>↗</span>
					</a>
				</div>

				<div class="project-grid">
					<a class="project-card" href={projectsUrl}>
						<div class="project-number">01</div>

						<div class="project-info">
							<h3>Eccentric Eclipse</h3>

							<p>
								我的个人博客。
								记录数学、技术与生活。
							</p>

							<div class="project-tags">
								<span>Astro</span>
								<span>Markdown</span>
								<span>GitHub Pages</span>
							</div>
						</div>

						<div class="card-arrow">↗</div>
					</a>

					<a class="project-card" href={projectsUrl}>
						<div class="project-number">02</div>

						<div class="project-info">
							<h3>AI & Experiments</h3>

							<p>
								一些关于 AI、记忆系统以及
								个人工具的实验。
							</p>

							<div class="project-tags">
								<span>AI</span>
								<span>Python</span>
								<span>Experiments</span>
							</div>
						</div>

						<div class="card-arrow">↗</div>
					</a>
				</div>
			</section>


			<!-- ========================================
			     Quote
			========================================= -->

			<section class="quote-section">
	             <div class="quote-symbol">“</div>

	             <blockquote>
		             Some things
		             <br />
		             are worth keeping.
	             </blockquote>

	             <p>
		             Notes from an ongoing journey.
	             </p>
            </section>
		</main>


		<footer>
			<div class="footer-inner">
				<div>
					<p class="footer-logo">TSY</p>
					<p class="footer-description">
						Mathematics · Thoughts · Life
					</p>
				</div>

				<div class="footer-right">
					<a href={homeUrl}>首页</a>
					<a href={postsUrl}>文章</a>
					<a href={projectsUrl}>项目</a>
					<a href={aboutUrl}>关于</a>
				</div>
			</div>

			<div class="footer-bottom">
				<span>© 2026 TSY</span>
				<span>Built with Astro</span>
			</div>
		</footer>
	</body>
</html>


<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		background: #fafafa;
		color: #202020;
		font-family:
			-apple-system,
			BlinkMacSystemFont,
			"Segoe UI",
			"PingFang SC",
			"Hiragino Sans GB",
			"Microsoft YaHei",
			sans-serif;
	}

	:global(a) {
		-webkit-tap-highlight-color: transparent;
	}

	main {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 32px;
	}


	/* ==============================
	   Hero
	================================ */

	.hero {
		position: relative;
		min-height: 610px;

		display: flex;
		align-items: center;

		border-bottom: 1px solid #e5e5e5;

		overflow: hidden;
	}

	.hero::before {
		position: absolute;
		inset: 22px 0 auto;
		height: 1px;
		background: #e5e5df;
		content: "";
	}

	.math-scatter {
		position: absolute;
		inset: 0;
		color: #a2a08e;
		font-family: Georgia, serif;
		font-size: 20px;
		opacity: 0.25;
		pointer-events: none;
	}

	.math-scatter span {
		position: absolute;
		opacity: 0.3;
	}

	.scatter-1 { top: 20%; right: 17%; font-size: 34px; transform: rotate(12deg); }
	.scatter-2 { top: 67%; left: 12%; font-size: 14px; transform: rotate(-7deg); }
	.scatter-3 { top: 79%; right: 8%; font-size: 28px; transform: rotate(-11deg); }
	.scatter-4 { top: 34%; left: 5%; font-size: 24px; transform: rotate(9deg); }

	.hero-inner {
		position: relative;
		z-index: 1;
		max-width: 760px;
		padding: 100px 0 120px;
	}

	.eyebrow {
		margin: 0 0 30px;

		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.2em;

		color: #999;
	}

	.hero h1 {
		margin: 0;

		font-family:
			Georgia,
			"Times New Roman",
			serif;

		font-size: clamp(54px, 8vw, 92px);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.055em;
	}

	.hero-description {
		margin: 38px 0 0;

		max-width: 560px;

		color: #707070;
		font-size: 16px;
		line-height: 1.9;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 24px;

		margin-top: 42px;
	}

	.primary-button {
		display: inline-flex;
		align-items: center;
		gap: 18px;

		padding: 13px 20px;

		background: #202020;
		color: #fff;

		font-size: 13px;
		text-decoration: none;

		transition:
			transform 0.2s ease,
			background 0.2s ease;
	}

	.primary-button:hover {
		background: #000;
		transform: translateY(-2px);
	}

	.primary-button span {
		font-size: 16px;
	}

	.text-button {
		color: #666;
		font-size: 13px;
		text-decoration: none;

		border-bottom: 1px solid #bbb;
		padding-bottom: 3px;

		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.text-button:hover {
		color: #111;
		border-color: #111;
	}

	.hero-mark {
		position: absolute;
		right: -20px;
		bottom: 10px;

		font-family: Georgia, serif;
		font-size: 320px;
		font-weight: 400;
		line-height: 1;

		color: #eeeeee;

		user-select: none;
		pointer-events: none;
	}


	/* ==============================
	   Section common
	================================ */

	section {
		padding: 108px 0;
	}

	.section-label {
		display: flex;
		align-items: center;
		gap: 16px;

		margin-bottom: 45px;

		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.18em;

		color: #999;
	}

	.section-label span:first-child {
		font-family: monospace;
		color: #bbb;
	}

	.section-label span:last-child {
		color: #777;
	}

	.thinking-section {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 60px;
		border-bottom: 1px solid #e5e5e5;
	}

	.thinking-section .section-label {
		margin: 0;
	}

	.thinking-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px 34px;
		align-content: start;
		padding-top: 2px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 25px;
	}

	.thinking-list span::before {
		margin-right: 10px;
		color: #aaa993;
		content: "∴";
		font-family: Georgia, serif;
		font-size: 13px;
		vertical-align: middle;
	}


	/* ==============================
	   About
	================================ */

	.about-section {
		border-bottom: 1px solid #e5e5e5;
	}

	.about-grid {
		display: grid;
		grid-template-columns: 1.1fr 0.9fr;
		gap: 100px;
	}

	.about-grid h2 {
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 52px);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.04em;
	}

	.about-text {
		max-width: 440px;
		padding-top: 8px;
	}

	.about-text p {
		margin: 0 0 22px;

		color: #707070;
		font-size: 15px;
		line-height: 1.9;
	}

	.arrow-link {
		display: inline-flex;
		align-items: center;
		gap: 12px;

		margin-top: 15px;

		color: #202020;
		font-size: 13px;
		text-decoration: none;

		border-bottom: 1px solid #bbb;
		padding-bottom: 5px;

		transition:
			gap 0.2s ease,
			border-color 0.2s ease;
	}

	.arrow-link:hover {
		gap: 18px;
		border-color: #202020;
	}


	/* ==============================
	   Posts
	================================ */

	.posts-section {
		border-bottom: 1px solid #e5e5e5;
	}

	.category-notes-section {
		border-bottom: 1px solid #e5e5e5;
	}

	.category-note-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 24px;
	}

	.category-note h2 {
		margin: 0 0 18px;
		color: #33332f;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 25px;
		font-weight: 400;
	}

	.category-note :global(.article-list) {
		border-top: 1px solid #e5e5df;
	}

	.category-note :global(.article-row) {
		display: block;
		padding: 16px 0;
	}

	.category-note :global(.article-row:hover) {
		padding-left: 6px;
	}

	.category-note :global(.article-index),
	.category-note :global(.article-main p),
	.category-note :global(.tags) {
		display: none;
	}

	.category-note :global(.article-main h2) {
		margin: 0;
		font-size: 17px;
	}

	.category-note :global(.article-main a) {
		margin-top: 8px;
		font-size: 11px;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		margin-bottom: 45px;
	}

	.section-heading .section-label {
		margin-bottom: 20px;
	}

	.section-heading h2 {
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 48px);
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.view-all {
		display: inline-flex;
		align-items: center;
		gap: 12px;

		color: #777;
		font-size: 12px;
		text-decoration: none;

		transition:
			color 0.2s ease,
			gap 0.2s ease;
	}

	.view-all:hover {
		color: #111;
		gap: 17px;
	}

	.post-list {
		border-top: 1px solid #ddd;
	}

	.post-item {
		display: grid;
		grid-template-columns: 180px 1fr 40px;
		gap: 30px;

		padding: 30px 0;

		border-bottom: 1px solid #e5e5e5;

		color: inherit;
		text-decoration: none;

		transition:
			padding 0.25s ease,
			background 0.25s ease;
	}

	.post-item:hover {
		padding-left: 14px;
		padding-right: 14px;
		background: #f5f5f5;
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		gap: 8px;

		font-family: monospace;
		font-size: 11px;
		color: #999;
	}

	.post-meta span {
		font-family: inherit;
		color: #b0b0b0;
	}

	.post-content h3 {
		margin: 0 0 9px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 24px;
		font-weight: 400;
		letter-spacing: -0.02em;
	}

	.post-content p {
		margin: 0;

		color: #777;
		font-size: 13px;
		line-height: 1.7;
	}

	.post-arrow {
		align-self: center;

		font-size: 20px;
		color: #aaa;

		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}

	.post-item:hover .post-arrow {
		transform: translate(3px, -3px);
		color: #202020;
	}


	/* ==============================
	   Projects
	================================ */

	.projects-section {
		border-bottom: 1px solid #e5e5e5;
	}

	.projects-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		margin-bottom: 55px;
	}

	.projects-heading h2 {
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(34px, 4vw, 50px);
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.04em;
	}

	.projects-heading .arrow-link {
		margin-bottom: 5px;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.project-card {
		position: relative;

		min-height: 330px;
		padding: 30px;

		display: flex;
		flex-direction: column;
		justify-content: space-between;

		border: 1px solid #dedede;

		color: inherit;
		text-decoration: none;

		transition:
			transform 0.25s ease,
			background 0.25s ease,
			border-color 0.25s ease;
	}

	.project-card:hover {
		transform: translateY(-5px);
		background: #f5f5f5;
		border-color: #ccc;
	}

	.project-number {
		font-family: monospace;
		font-size: 11px;
		color: #aaa;
	}

	.project-info h3 {
		margin: 0 0 15px;

		font-family: Georgia, "Times New Roman", serif;
		font-size: 30px;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.project-info p {
		max-width: 340px;
		margin: 0;

		color: #777;
		font-size: 13px;
		line-height: 1.8;
	}

	.project-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;

		margin-top: 25px;
	}

	.project-tags span {
		padding: 5px 8px;

		border: 1px solid #ddd;

		color: #999;
		font-family: monospace;
		font-size: 9px;
	}

	.card-arrow {
		position: absolute;
		top: 28px;
		right: 30px;

		font-size: 20px;
		color: #aaa;

		transition:
			transform 0.2s ease,
			color 0.2s ease;
	}

	.project-card:hover .card-arrow {
		transform: translate(3px, -3px);
		color: #202020;
	}


	/* ==============================
	   Quote
	================================ */

	.quote-section {
		padding: 180px 0;

		text-align: center;
	}

	.quote-symbol {
		margin-bottom: 15px;

		font-family: Georgia, serif;
		font-size: 70px;
		line-height: 1;

		color: #ddd;
	}

	blockquote {
		margin: 0;

		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(38px, 5vw, 60px);
		font-weight: 400;
		line-height: 1.25;
		letter-spacing: -0.04em;
	}

	.quote-section p {
		margin: 30px 0 0;

		font-family: monospace;
		font-size: 10px;
		letter-spacing: 0.12em;

		color: #aaa;
	}


	/* ==============================
	   Footer
	================================ */

	footer {
		max-width: 1100px;
		margin: 0 auto;

		padding: 0 32px 35px;
	}

	.footer-inner {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;

		padding: 35px 0;

		border-top: 1px solid #e5e5e5;
	}

	.footer-logo {
		margin: 0 0 8px;

		font-size: 18px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.footer-description {
		margin: 0;

		color: #aaa;
		font-family: monospace;
		font-size: 9px;
		letter-spacing: 0.1em;
	}

	.footer-right {
		display: flex;
		gap: 22px;
	}

	.footer-right a {
		color: #888;
		font-size: 11px;
		text-decoration: none;

		transition: color 0.2s ease;
	}

	.footer-right a:hover {
		color: #111;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;

