---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts");

console.log(posts);
---

<BaseLayout title="文章 · TSY">
	<header class="page-header">
		<p class="eyebrow">WRITING</p>

		<h1>文章</h1>

		<p class="intro">
			记录数学、技术，以及生活中那些值得留下来的想法。
		</p>
	</header>

	<main class="post-container">
	<div class="post-count">
		<span>ALL POSTS</span>
		<span>{posts.length} 篇文章</span>
	</div>

	<div class="post-list">
		{posts.map((post) => (
			<article class="post">
				<div class="post-meta">
					<time datetime={post.data.date.toISOString()}>
						{post.data.date.toLocaleDateString("zh-CN")}
					</time>

					<span>{post.data.category}</span>
				</div>

				<div class="post-content">
					<h2>{post.data.title}</h2>

					<p>{post.data.description}</p>

					<a href={`/eccentric-eclipse/posts/${post.id}/`}>
						阅读文章
						<span>→</span>
					</a>
				</div>
			</article>
		))}
	</div>
</main>
</BaseLayout>

<style>
	.page-header {
		max-width: 900px;
		margin: 0 auto;
		padding: 100px 24px 80px;
		border-bottom: 1px solid #e5e5e5;
	}

	.eyebrow {
		margin: 0 0 20px;
		font-size: 12px;
		letter-spacing: 0.18em;
		color: #888;
	}

	.page-header h1 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(48px, 8vw, 72px);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.04em;
	}

	.intro {
		max-width: 520px;
		margin: 28px 0 0;
		color: #777;
		font-size: 16px;
		line-height: 1.8;
	}

	.post-container {
		max-width: 900px;
		margin: 0 auto;
		padding: 0 24px 120px;
	}

	.post-count {
		display: flex;
		justify-content: space-between;
		padding: 20px 0;
		color: #999;
		font-family: monospace;
		font-size: 12px;
		letter-spacing: 0.04em;
	}

	.post {
		display: grid;
		grid-template-columns: 150px 1fr;
		gap: 40px;
		padding: 36px 0;
		border-top: 1px solid #e5e5e5;
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		gap: 8px;
		color: #999;
		font-family: monospace;
		font-size: 12px;
	}

	.post-meta span {
		color: #bbb;
	}

	.post-content h2 {
		margin: 0 0 12px;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 28px;
		font-weight: 500;
		line-height: 1.3;
	}

	.post-content p {
		max-width: 600px;
		margin: 0 0 18px;
		color: #777;
		line-height: 1.8;
	}

	.post-content a {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		color: #333;
		font-size: 13px;
		text-decoration: none;
	}

	.post-content a span {
		transition: transform 0.2s ease;
	}

	.post-content a:hover span {
		transform: translateX(4px);
	}

	@media (max-width: 600px) {
		.page-header {
			padding: 70px 20px 60px;
		}

		.post-container {
			padding: 0 20px 80px;
		}

		.post {
			grid-template-columns: 1fr;
			gap: 12px;
			padding: 28px 0;
		}

		.post-meta {
			flex-direction: row;
			gap: 16px;
		}
	}
</style>