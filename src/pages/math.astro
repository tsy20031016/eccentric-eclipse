---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { mathSubjects, getMathSubject } from "../utils/math-categories";

const posts = (await getCollection("posts"))
	.filter((post) => post.data.category === "数学")
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const groups = mathSubjects.map((subject) => {
	const subjectPosts = posts.filter((post) => getMathSubject(post.data.tags) === subject.name);
	return {
		...subject,
		posts: subjectPosts,
		general: subjectPosts.filter((post) => !subject.topics.some((topic) => post.data.tags.includes(topic.name))),
		topics: subject.topics.map((topic) => ({ ...topic, posts: subjectPosts.filter((post) => post.data.tags.includes(topic.name)) })),
	};
});
---

<BaseLayout title="数学 · TSY">
	<header class="page-header">
		<p class="eyebrow">MATHEMATICS</p>
		<h1>数学笔记。</h1>
		<p class="intro">关于分析、证明，以及仍在慢慢理解的问题。</p>
	</header>
	<main class="content-container">
		<div class="section-marker"><span>∫</span><span>{posts.length} 篇记录</span></div>
		<nav class="topic-nav" aria-label="数学文章分类">
			{groups.map((group) => (
				<a href={`#${group.id}`}><span>{group.name}</span><span class="topic-count">{group.posts.length}</span></a>
			))}
		</nav>
		{groups.map((group) => (
			<section class="topic-section" id={group.id} aria-labelledby={`${group.id}-title`}>
				<header class="topic-header">
					<h2 id={`${group.id}-title`}>{group.name}<span>{group.posts.length} 篇</span></h2>
					<p>{group.description}</p>
				</header>
				{group.topics.length > 0 ? (
					<div class="subject-content">
						<nav class="subtopic-nav" aria-label={`${group.name}子板块`}>
							{group.topics.map((topic) => <a href={`#${topic.id}`}>{topic.name}<span>{topic.posts.length}</span></a>)}
						</nav>
						{group.general.length > 0 && <section class="subtopic"><h3>综合笔记</h3><ArticleList posts={group.general} showCategory={false} /></section>}
						{group.topics.map((topic) => (
							<section class="subtopic" id={topic.id} aria-labelledby={`${topic.id}-title`}>
								<h3 id={`${topic.id}-title`}>{topic.name}<span>{topic.posts.length} 篇</span></h3>
								<ArticleList posts={topic.posts} showCategory={false} />
							</section>
						))}
					</div>
				) : <ArticleList posts={group.posts} showCategory={false} />}
			</section>
		))}
	</main>
</BaseLayout>

<style>
	.page-header, .content-container { max-width: 900px; margin: 0 auto; padding-left: 24px; padding-right: 24px; }
	.page-header { padding-top: 82px; padding-bottom: 72px; border-bottom: 1px solid #e5e5df; background: linear-gradient(90deg, rgba(239,239,231,.55), transparent 58%); }
	.eyebrow { margin: 0 0 18px; color: #8b8b83; font-size: 11px; letter-spacing: .18em; }
	h1 { margin: 0; color: #171717; font-family: Georgia, "Times New Roman", serif; font-size: clamp(46px, 7vw, 70px); font-weight: 400; line-height: 1.1; }
	.intro { max-width: 560px; margin: 24px 0 0; color: #4e4e4a; font-size: 16px; line-height: 1.8; }
	.content-container { padding-top: 34px; padding-bottom: 100px; }
	.section-marker { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; color: #8b8b83; font-family: monospace; font-size: 11px; }
	.section-marker span:first-child { color: #aaa993; font-family: Georgia, serif; font-size: 18px; }
	.topic-nav { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 42px; }
	.topic-nav a { display: inline-flex; align-items: center; gap: 16px; padding: 12px 18px; border: 1px solid #e5e5df; border-radius: 6px; color: #333; text-decoration: none; font-size: 14px; }
	.topic-nav a:hover, .topic-nav a:focus-visible { background: #efefe7; border-color: #aaa993; }
	.topic-count { color: #8b8b83; font-family: monospace; font-size: 12px; }
	.topic-section { margin-top: 42px; scroll-margin-top: 100px; }
	.topic-header { margin-bottom: 22px; }
	.topic-header h2 { display: flex; align-items: baseline; gap: 16px; margin: 0; color: #171717; font-size: 25px; font-weight: 400; }
	.topic-header h2 span { color: #8b8b83; font-size: 12px; }
	.topic-header p { margin: 10px 0 0; color: #777; font-size: 13px; line-height: 1.8; }
	.subject-content { padding-left: 22px; border-left: 2px solid #e5e5df; }
	.subtopic-nav { display: flex; flex-wrap: wrap; gap: 12px; margin: 24px 0; }
	.subtopic-nav a { display: inline-flex; gap: 12px; padding: 8px 12px; color: #444; background: #efefe7; border-radius: 4px; text-decoration: none; font-size: 13px; }
	.subtopic-nav a:hover, .subtopic-nav a:focus-visible { outline: 1px solid #aaa993; }
	.subtopic-nav span, .subtopic h3 span { color: #8b8b83; font-size: 12px; }
	.subtopic { margin-top: 32px; scroll-margin-top: 100px; }
	.subtopic h3 { display: flex; align-items: baseline; gap: 16px; margin: 0 0 18px; font-size: 20px; font-weight: 400; }
	@media (max-width: 600px) { .page-header { padding: 68px 20px 58px; } .content-container { padding: 28px 20px 80px; } }
</style>
